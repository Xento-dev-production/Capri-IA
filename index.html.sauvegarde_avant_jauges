      const ok = await volerVersCapri(monFlux, s);
      if (!ok || !encore()) return;

      // === L'arrivée : elle attrape la tablette ===
      discTab.style.display = 'none';
      cacherLien();
      poserTablette('lecture', 1);
      const m = mainsCapri();
      const hautY = window.innerHeight - ay - sprite.offsetHeight;
      flashBlanc(240, 0.28, '#27e6ff');
      glitchEcran(260);
      secousseEcran(5, 220);
      ondeChoc(m.x, m.y);
      eclair(m.x + alea(-90, 90), -10, m.x, m.y, {                // un éclair frappe la tablette
        couleur: '#27e6ff', halo: '#27e6ff', coeur: '#ffffff', epaisseur: 3.2,
        duree: 600, descente: 90, rugosite: 0.4, pas: 6, branches: 0.06, echelleBr: 0.8
      });
      walker.animate([
        { filter: 'brightness(3) drop-shadow(0 0 18px #27e6ff)' },
        { filter: 'brightness(1.4) drop-shadow(0 0 10px #00ffa3)', offset: 0.4 },
        { filter: 'none' }
      ], { duration: 520 });
      particules(m.x, m.y, {
        couleurs: ['#27e6ff', '#00ffa3', '#ffffff'], n: 22, vmin: 100, vmax: 380,
        tailleMin: 2, tailleMax: 5, angleMin: -Math.PI, angleMax: Math.PI, duree: 480
      });
      faisceauDonnees(m.x, m.y, tabCentreX, hautY);               // le message coule des mains vers sa tête
      son('connecte');
      await wait(420);
      if (!encore()) return;

      // Elle lit pendant que l'IA réfléchit
      demarrerLecture(s);
      bulleAttente(s);
      const reply = await ipcRenderer.invoke('ask', history.concat([{ role: 'user', content: texte }]));
      arreterLecture();
      if (!encore()) return;
      const erreur = reply.startsWith('[Erreur');
      if (!erreur) {
        history.push({ role: 'user', content: texte });
        history.push({ role: 'assistant', content: reply });
        while (history.length > 20) history.splice(0, 2);
      }
      // La discussion apparaît aussi dans la fenêtre d'appel
      addRow('moi').textContent = texte;
      addRow('capri').textContent = reply;

      const aDire = erreur ? "Pas de signal, choom... Ollama est bien lancé ?" : reply;
      const duree = Math.min(BULLE_REPONSE_MAX, Math.max(BULLE_REPONSE_MIN, aDire.length * BULLE_REPONSE_PAR_CARACTERE));

      // La réponse arrive : flash vert, glitch, petit jingle, la bulle "grésille" en apparaissant
      flashBlanc(200, 0.2, erreur ? '#ff2e63' : '#00ffa3');
      glitchEcran(220);
      son(erreur ? 'echec' : 'recu');
      const fx = () => {
        bulle.animate([
          { filter: 'hue-rotate(90deg) brightness(2.2)' }, { filter: 'none' },
          { filter: 'hue-rotate(-70deg) brightness(1.7)' }, { filter: 'none' }
        ], { duration: 340, easing: 'steps(4)' });
      };
      const fini = await direTexte(aDire, duree, 1200, BULLE_REPONSE_VITESSE, fx);
      if (!fini || !encore()) return;
      await finDiscussion(s);
    } finally {
      arreterLecture();
      if (monFlux === flux) { discTab.style.display = 'none'; cacherLien(); }
    }
  }

  // Petite boucle pendant qu'on tient la tablette : elle penche selon la vitesse de la souris et pulse
  function boucleTabTenue() {
    if (!tabTenue) { rafTabHold = null; return; }
    tabVX *= 0.82;
    tabRot = -8 + borner(tabVX * 1.2, -28, 28);
    placerTab(tabX, tabY, tabRot, 1 + 0.03 * Math.sin(performance.now() / 120));
    rafTabHold = requestAnimationFrame(boucleTabTenue);
  }

  // On appuie sur le bouton de compression : le panneau devient une tablette que l'on tient
  // (auto = true : envoi direct avec Entrée, la tablette part toute seule)
  function demarrerTablette(px, py, auto) {
    if (!enAnim || tabActif || !panneauOuvert) return;
    const texte = discInput.value.trim();
    if (!texte) { signalerPanneau("ÉCRIS D'ABORD UN MESSAGE..."); discInput.focus(); return; }
    if (occupee() && etat !== 'tablette') { signalerPanneau('CAPRI EST OCCUPÉE... RÉESSAIE DANS UN INSTANT'); return; }

    const monFlux = ++flux;
    tabActif = true;
    tabTenue = true;
    panneauOuvert = false;
    survolPanneau = false;
    discInput.value = '';
    discInput.blur();
    prendreCapri();
    const s = session;
    tabX = px; tabY = py; tabVX = 0; tabRot = -8;
    dernierFantX = px; dernierFantY = py;
    tbTxt.textContent = '> ' + texte.slice(0, 60);
    discTab.style.display = 'block';
    placerTab(px, py, -8, 1);
    discTab.animate([{ scale: 0.3, opacity: 0 }, { scale: 1, opacity: 1 }], { duration: 260, easing: 'ease-out' });

    // Naissance de la tablette : onde de choc, glitch, étincelles, et un lien + un viseur se verrouillent sur Capri
    ondeChoc(px, py);
    glitchEcran(240);
    particules(px, py, {
      couleurs: ['#27e6ff', '#00ffa3', '#ffffff'], n: 16, vmin: 80, vmax: 320,
      tailleMin: 2, tailleMax: 4, angleMin: -Math.PI, angleMax: Math.PI, duree: 420
    });
    comprimerPanneau();
    son('compresse');
    viser(px, py);
    montrerLien();
    majLien(px, py);
    majClic();

    if (auto) {
      tabTenue = false; tabActif = false; majClic();
      lancerEnvoi(monFlux, s, texte, true);
      return;
    }

    cancelAnimationFrame(rafTabHold);
    rafTabHold = requestAnimationFrame(boucleTabTenue);
    const bouge = (m) => {
      tabVX += ((m.clientX - tabX) - tabVX) * 0.35;
      tabX = m.clientX; tabY = m.clientY;
      viser(tabX, tabY);
      majLien(tabX, tabY);
      if (Math.hypot(tabX - dernierFantX, tabY - dernierFantY) > 20) {     // traînée de fantômes
        dernierFantX = tabX; dernierFantY = tabY;
        fantomeTab(tabX, tabY, tabRot, 1);
      }
      if (Math.random() < 0.3) glyphe(tabX + alea(-24, 24), tabY + alea(-18, 18));
    };
    const retirer = () => {
      window.removeEventListener('pointermove', bouge);
      window.removeEventListener('pointerup', fin);
      window.removeEventListener('pointercancel', fin);
      tabNettoyer = null;
    };
    const fin = () => {
      retirer();
      tabTenue = false; tabActif = false;
      cancelAnimationFrame(rafTabHold);
      majClic();
      lancerEnvoi(monFlux, s, texte, false);
    };
    window.addEventListener('pointermove', bouge);
    window.addEventListener('pointerup', fin);
    window.addEventListener('pointercancel', fin);
    tabNettoyer = retirer;
  }

  discCompress.addEventListener('pointerdown', (e) => {
    if (e.button !== 0) return;
    e.preventDefault();
    demarrerTablette(e.clientX, e.clientY, false);
  });
  discInput.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' || e.shiftKey) return;
    e.preventDefault();
    const r = discCompress.getBoundingClientRect();
    demarrerTablette(r.left + r.width / 2, r.top + r.height / 2, true);
  });

  // Fin de la balade : tout est remis à zéro
  function nettoyerDiscussion() {
    flux++;
    if (tabNettoyer) tabNettoyer();
    cancelAnimationFrame(rafVol);
    cancelAnimationFrame(rafTabHold);
    clearInterval(pointsTimer);
    clearTimeout(aideTimer);
    arreterLecture();
    cacherLien();
    discPanel.getAnimations().forEach((a) => a.cancel());
    discTab.getAnimations().forEach((a) => a.cancel());
    discBtn.getAnimations().forEach((a) => a.cancel());
    discBtn.style.display = 'none';
    discPanel.style.display = 'none';
    discTab.style.display = 'none';
    discHint.textContent = TEXTE_AIDE;
    discHint.classList.remove('mal');
    panneauOuvert = false; tabActif = false; tabTenue = false;
    survolBtn = false; survolPanneau = false;
  }

</script>

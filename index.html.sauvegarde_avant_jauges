    [['#27e6ff', 0], ['#00ffa3', 130]].forEach(([c, delai]) => {
      const o = document.createElement('div');
      o.style.cssText = 'position:fixed;pointer-events:none;z-index:97;border-radius:50%;' +
        'width:20px;height:20px;border:2px solid ' + c + ';box-shadow:0 0 10px ' + c + ';' +
        'left:' + (x - 10) + 'px;top:' + (y - 10) + 'px;opacity:0';
      document.body.appendChild(o);
      o.animate(
        [{ opacity: 0.95, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(11)' }],
        { duration: 560, delay: delai, easing: 'ease-out', fill: 'both' }
      ).onfinish = () => o.remove();
    });
  }

  function boucleChutePuce(now) {
    const dt = Math.min(0.033, Math.max(0.001, (now - puceDernier) / 1000));
    puceDernier = now;
    let rotCible = 0;
    if (puceMode === 'vol') {
      puceVY += GRAVITE_PUCE * dt;
      puceX += puceVX * dt;
      puceY += puceVY * dt;
      if (puceX < PUCE_LARGEUR / 2) { puceX = PUCE_LARGEUR / 2; puceVX = Math.abs(puceVX) * 0.5; }
      if (puceX > window.innerWidth - PUCE_LARGEUR / 2) { puceX = window.innerWidth - PUCE_LARGEUR / 2; puceVX = -Math.abs(puceVX) * 0.5; }
      const sol = window.innerHeight - PUCE_HAUTEUR / 2 - 2;
      if (puceY >= sol) {                         // elle touche le sol : elle rebondit puis se pose
        puceY = sol;
        if (Math.abs(puceVY) > 280) { puceVY *= -0.4; puceVX *= 0.6; }
        else { puceVY = 0; puceVX = 0; puceMode = 'sol'; }
      }
    } else if (puceMode === 'tenue' && portSurvole) {
      rotCible = ROT_PUCE;
      // Près d'un port : de petits arcs électriques relient le port à la puce
      if (now > prochainArc) {
        prochainArc = now + 130;
        const r = portSurvole.getBoundingClientRect();
        eclair(r.left + r.width / 2 + alea(-16, 16), r.bottom, puceX + alea(-20, 20), puceY - PUCE_HAUTEUR / 2, {
          couleur: '#27e6ff', halo: '#27e6ff', epaisseur: 1.3, duree: 170, descente: 30,
          rugosite: 0.5, pas: 4, branches: 0, echelleBr: 0
        });
      }
    } else if (puceMode === 'entre' && puceEntre) {
      // Insertion réaliste : approche de travers, (souvent) mauvais sens, correction, résistance, puis "clic"
      const E = puceEntre;
      if (!E.init) {
        E.init = true;
        E.dx = alea(11, 17) * (Math.random() < 0.5 ? -1 : 1);   // décalage de la mauvaise tentative
        E.ex = E.echec ? E.xa : E.x0;                             // d'où part la deuxième approche
        E.ey = E.echec ? E.ya + 40 : E.y0;
        E.er = E.echec ? 0 : E.rot0;
      }
      const tt = now - E.t0 + (E.echec ? 0 : 1500);
      const ent = (a, b) => lisse(Math.min(1, Math.max(0, (tt - a) / (b - a))));
      const sg = Math.sign(E.dx);
      if (tt < 520) {                                // 1. elle s'approche du port, un peu de travers
        const e = ent(0, 520);
        puceX = E.x0 + (E.xa + E.dx - E.x0) * e;
        puceY = E.y0 + (E.ya + 46 - E.y0) * e;
        puceRot = E.rot0 + (sg * 7 - E.rot0) * e;
      } else if (tt < 760) {                         // 2. elle pousse : ça ne rentre pas
        const e = ent(520, 760);
        puceX = E.xa + E.dx;
        puceY = E.ya + 46 - 54 * e;
        puceRot = sg * 7;
        if (!E.rate && tt >= 740) { E.rate = true; echecPort(E); }
      } else if (tt < 1060) {                        // 3. elle rebondit en arrière en tremblant
        const e = ent(760, 1060);
        puceX = E.xa + E.dx;
        puceY = E.ya - 8 + 48 * e;
        puceRot = sg * 7 + Math.sin((tt - 760) / 35) * 6 * (1 - e);
      } else if (tt < 1500) {                        // 4. elle se remet dans le bon axe
        const e = ent(1060, 1500);
        puceX = E.xa + E.dx * (1 - e);
        puceY = E.ya + 40;
        puceRot = sg * 7 * (1 - e) + Math.sin(e * Math.PI * 2) * 3 * (1 - e);
      } else if (tt < 1850) {                        // 5. deuxième approche, bien droite
        if (E.echec && !E.reessai) { E.reessai = true; usbHint.textContent = 'RÉESSAI...'; usbHint.style.color = 'var(--cyan)'; }
        const e = ent(1500, 1850);
        puceX = E.ex + (E.xa - E.ex) * e;
        puceY = E.ey + (E.ya - E.ey) * e;
        puceRot = E.er * (1 - e);
      } else if (tt < 2050) {                        // 6. l'aimant la capte : elle vibre
        puceX = E.xa + (Math.random() - 0.5) * 3;
        puceY = E.ya + (Math.random() - 0.5) * 3;
        puceRot = 0;
      } else {                                       // 7. elle s'enfonce, avec de la résistance, puis "clic"
        const q = Math.min(1, (tt - 2050) / (DUREE_ENTREE - 2050));
        puceX = E.xa;
        puceY = E.ya + (E.y1 - E.ya) * q * q * q;
        puceRot = 0;
        if (!E.contact && q >= 0.94) contactPort(E);
      }
    } else if (puceMode === 'entre-ancien' && puceEntre) {
      const E = puceEntre;
      const p = Math.min(1, (now - E.t0) / DUREE_ENTREE);
      if (p < 0.4) {                               // 1. l'aimant l'attire sous le port
        const e = lisse(p / 0.4);
        puceX = E.x0 + (E.xa - E.x0) * e;
        puceY = E.y0 + (E.ya - E.y0) * e;
        puceRot = E.rot0 + (ROT_PUCE - E.rot0) * e;
      } else if (p < 0.62) {                       // 2. elle vibre, juste sous l'ouverture
        puceX = E.xa + (Math.random() - 0.5) * 3;
        puceY = E.ya + (Math.random() - 0.5) * 3;
        puceRot = ROT_PUCE;
      } else {                                     // 3. elle s'enfonce dans le port (elle passe derrière lui)
        const q = (p - 0.62) / 0.38;
        puceX = E.xa;
        puceY = E.ya + (E.y1 - E.ya) * q * q;
        puceRot = ROT_PUCE;
        if (!E.contact) {                          // contact : étincelles, ondes de choc, le port flashe
          E.contact = true;
          E.port.classList.add('connecte', 'flash');
          setTimeout(() => E.port.classList.remove('flash'), 220);
          ondeChoc(E.xa, E.bas);
          particules(E.xa, E.bas, {
            couleurs: ['#00ffa3', '#ffffff', '#27e6ff'], n: 14, vmin: 100, vmax: 340,
            tailleMin: 2, tailleMax: 4, angleMin: 0.15, angleMax: Math.PI - 0.15, duree: 400
          });
        }
      }
    }
    if (puceMode !== 'entre') puceRot += (rotCible - puceRot) * Math.min(1, dt * 10);

    // Quand elle se présente devant un port, la rotation s'arrête, côté gauche de face
    const verrou = puceMode === 'entre' || (puceMode === 'tenue' && portSurvole);
    if (verrou) {
      if (!puceImg.src.endsWith(PUCE_IMAGES[0])) puceImg.src = PUCE_IMAGES[0];
      puceAng += (0 - puceAng) * Math.min(1, dt * 14);
    } else if (now > puceTourT) {
      puceEtape = (puceEtape + 1) % ETAPES_TOUR;
      puceTourT = now + DELAI_TOUR_PUCE;
      imagePuce();
    }
    if (puceMode === 'tenue') fragmentsPuce();
    placerPuce();
    rafPuce = requestAnimationFrame(boucleChutePuce);
  }

  // La puce jaillit du point d'impact, part très haut en l'air et retombe un peu plus loin
  function lancerPuce(x, y, calme) {
    cancelAnimationFrame(rafPuce);
    puceActive = true;
    puceEl.style.display = 'block';
    puceEl.style.pointerEvents = 'none';   // on ne peut pas l'attraper tant que Capri est encore là
    puceEl.style.width = PUCE_LARGEUR + 'px';
    puceEl.style.height = PUCE_HAUTEUR + 'px';
    puceCible.style.width = (PUCE_LARGEUR + 32) + 'px';
    puceCible.style.height = (PUCE_HAUTEUR + 30) + 'px';
    puceEl.classList.remove('tenue');
    puceEl.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 250 }); // elle ne surgit pas d'un coup
    puceX = borner(x, PUCE_LARGEUR / 2, window.innerWidth - PUCE_LARGEUR / 2);
    puceY = calme ? y : y - 30;
    // Elle part très haut en l'air (parfois hors de l'écran), du côté où il y a le plus de place,
    // et retombe un peu plus loin : change 200/380 pour la faire tomber plus près ou plus loin
    const dir = x < window.innerWidth / 2 ? 1 : -1;
    puceVX = calme ? alea(-140, 140) : dir * alea(200, 380);
    puceVY = calme ? -alea(80, 320) : -alea(1300, 1700);
    puceMode = 'vol'; puceK = 1; puceRot = 0; puceAng = 0; puceEtape = 0; puceTourT = 0; portSurvole = null;
    puceDernier = performance.now();
    imagePuce();
    placerPuce();
    rafPuce = requestAnimationFrame(boucleChutePuce);
  }

  // Affiche ou cache le message "INSÈRE LA PUCE" ; remet les ports à zéro
  // NOUVEAU : quand une puce est à brancher, le dock s'ouvre tout seul (les ports glissent à leur place) ;
  // quand c'est fini, il se range.
  function afficherUSB(oui) {
    usbHint.style.display = oui ? 'block' : 'none';
    if (oui) {
      usbHint.textContent = 'INSÈRE LA PUCE';
      usbHint.style.color = ''; usbHint.style.textShadow = ''; usbHint.style.animation = '';
    }
    ports.forEach((p) => p.classList.remove('survol', 'connecte', 'flash'));
    dockForce = oui;
    setDock(oui);
  }

  // Le port le plus proche du curseur (ou null si on est trop loin)
  function portSous(x, y) {
    let meilleur = null, dmin = PORTEE_PORT;
    ports.forEach((p) => {
      const r = p.getBoundingClientRect();
      const d = Math.hypot(x - (r.left + r.width / 2), y - (r.top + r.height / 2));
      if (d < dmin) { dmin = d; meilleur = p; }
    });
    return meilleur;
  }
  function surlignerPort(p) { ports.forEach((q) => q.classList.toggle('survol', q === p)); }

  // ===== Les effets de la connexion de la puce =====

  // Un texte qui se "décode" : des caractères au hasard se transforment peu à peu en vrai texte
  function decoder(el, texte, duree) {
    const CH = '01ABCDEF#<>/$%';
    const t0 = performance.now();
    return new Promise((res) => {
      const iv = setInterval(() => {
        const p = Math.min(1, (performance.now() - t0) / duree);
        const n = Math.floor(p * texte.length);
        let r = texte.slice(0, n);
        for (let i = n; i < texte.length; i++) r += texte[i] === ' ' ? ' ' : CH[Math.floor(Math.random() * CH.length)];
        el.textContent = r;
        if (p >= 1) { clearInterval(iv); el.textContent = texte; res(); }
      }, 40);
    });
  }

  // Tout l'écran "bugue" un instant : des bandes de couleur sautent de gauche à droite
  function glitchEcran(duree) {
    const g = document.createElement('div');
    g.style.cssText = 'position:fixed;inset:0;z-index:95;pointer-events:none;overflow:hidden';
    document.body.appendChild(g);
    const couleurs = ['#27e6ff', '#ff2e63', '#00ffa3', '#ffffff'];
    for (let i = 0; i < 12; i++) {
      const b = document.createElement('div');
      b.style.cssText = 'position:absolute;left:0;right:0;top:' + alea(0, 100).toFixed(1) + '%;height:' +
        alea(2, 38).toFixed(0) + 'px;background:' + couleurs[Math.floor(Math.random() * couleurs.length)] +
        ';mix-blend-mode:screen;opacity:0';
      g.appendChild(b);
      b.animate([
        { opacity: 0, transform: 'translateX(0px)' },
        { opacity: alea(0.15, 0.4), transform: 'translateX(' + alea(-70, 70).toFixed(0) + 'px)', offset: 0.3 },
        { opacity: 0, transform: 'translateX(' + alea(-70, 70).toFixed(0) + 'px)' }
      ], { duration: alea(60, 170), delay: alea(0, duree * 0.7), easing: 'steps(3)', fill: 'both' });
    }
    setTimeout(() => g.remove(), duree + 400);
  }

  // Des ondes à plat qui partent du sol, là où Capri a disparu
  function ondesSol(x, y) {
    [['#27e6ff', 0], ['#00ffa3', 150], ['#ffffff', 300]].forEach(([c, delai]) => {
      const o = document.createElement('div');
      o.style.cssText = 'position:fixed;pointer-events:none;z-index:97;border-radius:50%;opacity:0;' +
        'border:2px solid ' + c + ';box-shadow:0 0 10px ' + c + ';box-sizing:border-box;' +
        'width:40px;height:12px;left:' + (x - 20) + 'px;top:' + (y - 12) + 'px';
      document.body.appendChild(o);
      o.animate([
        { opacity: 0.9, width: '40px', height: '12px', left: (x - 20) + 'px', top: (y - 12) + 'px' },
        { opacity: 0, width: '640px', height: '110px', left: (x - 320) + 'px', top: (y - 60) + 'px' }
      ], { duration: 750, delay: delai, easing: 'ease-out', fill: 'both' }).onfinish = () => o.remove();
    });
  }

  // Des chiffres et des lettres de code qui coulent du port jusqu'à Capri, comme un flux de données
  function faisceauDonnees(x1, y1, x2, y2) {
    const couleurs = ['#27e6ff', '#27e6ff', '#00ffa3', '#ffffff'];
    for (let i = 0; i < 46; i++) {
      const c = couleurs[Math.floor(Math.random() * couleurs.length)];
      const el = document.createElement('div');
      el.textContent = TRAINEE_CARACTERES[Math.floor(Math.random() * TRAINEE_CARACTERES.length)];
      el.style.cssText = 'position:fixed;pointer-events:none;z-index:97;left:0;top:0;opacity:0;' +
        'font-family:Consolas,"Courier New",monospace;font-weight:bold;font-size:' + alea(10, 17).toFixed(0) + 'px;' +
        'color:' + c + ';text-shadow:0 0 6px ' + c + ';';
      document.body.appendChild(el);
      const dx = alea(-28, 28);
      el.animate([
        { opacity: 0, transform: 'translate(' + (x1 + dx).toFixed(0) + 'px,' + y1.toFixed(0) + 'px)' },
        { opacity: 1, offset: 0.15 },
        { opacity: 1, offset: 0.8 },
        { opacity: 0, transform: 'translate(' + (x2 + dx * 0.3).toFixed(0) + 'px,' + (y2 - 10).toFixed(0) + 'px)' }
      ], { duration: alea(500, 800), delay: alea(0, 550), easing: 'ease-in', fill: 'both' }).onfinish = () => el.remove();
    }
  }

  // Une colonne de lumière bleue à l'endroit où Capri a disparu : elle reste pendant la réinitialisation
  let pilierEl = null;
  function poserPilier(x) {
    retirerPilier();
    const el = document.createElement('div');
    el.style.cssText = 'position:fixed;pointer-events:none;z-index:56;bottom:0;left:' + (x - 34) + 'px;' +
      'width:68px;height:320px;clip-path:polygon(20% 0, 80% 0, 100% 100%, 0 100%);' +
      'background:linear-gradient(to top, rgba(39,230,255,0.65), rgba(39,230,255,0.18) 55%, transparent);' +
      'filter:drop-shadow(0 0 10px #27e6ff);';
    document.body.appendChild(el);
    el.animate([{ opacity: 0.95 }, { opacity: 0.35 }, { opacity: 0.95 }], { duration: 900, iterations: Infinity });
    pilierEl = el;
  }
  function retirerPilier() { if (pilierEl) { pilierEl.remove(); pilierEl = null; } }

  // Le bandeau "PUCE CONNECTÉE" sous les ports : le titre se décode, des lignes s'écrivent, une barre se remplit
  const LIGNES_CONNEXION = ['> SIGNATURE : VALIDE', '> LIEN NEURAL : ÉTABLI', '> CAPRI : RESTAURATION'];
  let bandeauEl = null;
  function bandeauConnexion(r, s) {
    const el = document.createElement('div');
    el.style.cssText = 'position:fixed;z-index:97;pointer-events:none;right:16px;top:' + Math.round(r.bottom + 40) + 'px;';
    el.innerHTML = '<div class="tag-cadre"><div class="tag-in" style="padding:9px 20px 10px 12px;min-width:250px">' +
      '<div class="tag-t"><span class="bd-t"></span></div>' +
      '<div class="bd-l" style="margin-top:7px;font-size:10px;letter-spacing:2px;line-height:1.8;color:var(--cyan);min-height:54px"></div>' +
      '<div class="jb" style="margin-top:8px"><div class="jf bd-f"></div></div></div></div>';
    document.body.appendChild(el);
    ouvrirFenetre(el);
    const titre = el.querySelector('.bd-t'), liste = el.querySelector('.bd-l'), barre = el.querySelector('.bd-f');
    barre.animate([{ width: '0%' }, { width: '100%' }], { duration: 1400, easing: 'steps(14)', fill: 'forwards' });
    (async () => {
      await decoder(titre, 'PUCE CONNECTÉE', 450);
      for (const txt of LIGNES_CONNEXION) {
        if (s !== session) return;
        const l = document.createElement('div');
        liste.appendChild(l);
        await decoder(l, txt, 380);
      }
    })();
    return el;
  }
  async function fermerBandeau() {
    const el = bandeauEl;
    bandeauEl = null;
    if (!el) return;
    await el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 220, fill: 'forwards' }).finished;
    el.remove();
  }

  // Retire tout ce qui concerne la puce
  function nettoyerPuce() {
    retirerPilier();
    if (bandeauEl) { bandeauEl.remove(); bandeauEl = null; }
    cancelAnimationFrame(rafPuce);
    puceActive = false; puceMode = 'vol'; puceTenue = false; survolPuce = false; puceEntre = null;
    portSurvole = null; puceRot = 0; puceAng = 0;
    puceEl.style.display = 'none';
    puceEl.style.pointerEvents = '';
    puceEl.classList.remove('tenue');
    puceTag.style.display = 'none';
    puceCible.style.display = 'none';
    puceAura.style.display = 'none';
    rebootEl.style.display = 'none';
    arreterPluie();
    afficherUSB(false);
  }

  // La foudre tombe sur Capri écrasée : elle disparaît, et on peut attraper la puce
  async function sequencePuce(s) {
    cancelAnimationFrame(raf);
    etat = 'puce';
    survolCapri = false;
    walker.style.pointerEvents = 'none';   // Capri est partie : elle ne doit plus réagir à la souris
    majClic();

    const x = ax + sprite.offsetWidth / 2, bas = window.innerHeight - 2;
    eclair(x + alea(-90, 90), -10, x, bas, {
      couleur: '#dfeaff', halo: 'rgba(190,215,255,0.95)', epaisseur: 3.5,
      duree: 750, descente: 85, rugosite: 0.38, pas: 7, branches: 0.05, echelleBr: 1
    });
    await wait(85);
    if (s !== session) return;
    impact(x, bas);
    walker.animate([{ filter: 'brightness(4)' }, { filter: 'none' }], { duration: 200 });
    await wait(110);
    if (s !== session) return;
    walker.style.opacity = 0;
    await wait(300);
    if (s !== session) return;

    // Maintenant on peut attraper la puce
    puceSession = s;
    puceEl.style.pointerEvents = '';
    afficherUSB(true);
  }

  // On lâche la puce sur un port : l'aimant l'attire, elle vibre, puis s'enfonce dans le port.
  // Au contact : ondes de choc, flash, et un éclair électrique descend du port jusqu'à l'endroit où Capri a disparu.
  async function inserer(port) {
    const s = puceSession;
    puceMode = 'entre';
    portSurvole = null;
    surlignerPort(port);
    const r = port.getBoundingClientRect();
    puceEntre = {
      x0: puceX, y0: puceY, rot0: puceRot,
      xa: r.left + r.width / 2, ya: r.bottom + PUCE_HAUTEUR / 2 + 14,   // où elle se place avant d'entrer
      y1: r.bottom - PUCE_HAUTEUR / 2 - 4,                               // où elle finit (cachée derrière le port)
      bas: r.bottom, port: port, t0: performance.now(), contact: false,
      echec: Math.random() < CHANCE_ECHEC_USB          // première tentative ratée (mauvais sens) ?
    };
    puceEntre.duree = puceEntre.echec ? DUREE_ENTREE : DUREE_ENTREE - 1500;
    puceEl.style.pointerEvents = 'none';
    await wait(puceEntre.duree + 80);
    if (s !== session) return;

    // Elle est entrée : le port reste allumé en vert
    cancelAnimationFrame(rafPuce);
    puceActive = false;
    puceEl.style.display = 'none';
    puceTag.style.display = 'none';
    puceCible.style.display = 'none';
    puceAura.style.display = 'none';
    port.classList.add('connecte');
    particules(puceEntre.xa, r.top + r.height / 2, {
      couleurs: ['#00ffa3', '#ffffff', '#27e6ff'], n: 22, vmin: 120, vmax: 420,
      tailleMin: 2, tailleMax: 5, angleMin: -Math.PI, angleMax: Math.PI, duree: 500
    });
    usbHint.textContent = 'PUCE CONNECTÉE';
    usbHint.style.color = 'var(--vert)';
    usbHint.style.textShadow = '0 0 6px rgba(0, 255, 163, 0.7)';
    usbHint.style.animation = 'none';
    survolPuce = false;
    majClic();

    // === La grande scène de connexion ===
    // L'écran bugue, un bandeau s'écrit sous les ports, un gros éclair bleu (et deux fins) descend du port
    // jusqu'à Capri pendant qu'un flux de code coule le long du chemin, puis des ondes et une colonne de lumière
    // apparaissent là où elle a disparu.
    const px = puceEntre.xa, py = r.bottom;
    const cx = ax + sprite.offsetWidth / 2, bas = window.innerHeight - 2;
    glitchEcran(700);
    flashUsb.animate([{ opacity: 0 }, { opacity: 1, offset: 0.2 }, { opacity: 0 }], { duration: 450 });
    bandeauEl = bandeauConnexion(r, s);
    eclair(px, py, cx, bas, {
      couleur: '#27e6ff', halo: '#27e6ff', coeur: '#ffffff', epaisseur: 4.2,
      duree: 900, descente: 170, rugosite: 0.42, pas: 7, branches: 0.09, echelleBr: 1
    });
    [90, 180].forEach((d) => setTimeout(() => {
      if (s !== session) return;
      eclair(px + alea(-24, 24), py, cx + alea(-50, 50), bas, {
        couleur: '#00ffa3', halo: '#00ffa3', coeur: '#ffffff', epaisseur: 1.8,
        duree: 600, descente: 120, rugosite: 0.5, pas: 6, branches: 0.05, echelleBr: 0.6
      });
    }, d));
    faisceauDonnees(px, py, cx, bas);
    son('donnees');
    await wait(170);

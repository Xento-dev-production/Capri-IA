  }
  function ajouterErreur(s) {
    const ms = performance.now() - rebootT0;
    const horo = String(Math.floor(ms / 60000)).padStart(2, '0') + ':' + String(Math.floor(ms / 1000) % 60).padStart(2, '0') +
      '.' + String(Math.floor(ms % 1000)).padStart(3, '0');
    const grave = Math.random() < 0.2;
    errTotal++;
    if (grave) errCrit++;
    const l = document.createElement('div');
    l.className = 'lg';
    l.innerHTML = '<span class="lt"></span><span class="bad">[' + (grave ? 'CRITIQUE' : 'ERREUR') + ']</span>';
    l.firstChild.textContent = '[' + horo + '] ERR_0x' + hex(4) + '  ' + ERREURS[Math.floor(Math.random() * ERREURS.length)];
    errLog.appendChild(l);
    while (errLog.children.length > 10) errLog.removeChild(errLog.firstChild);
    majErr();
    const tag = l.lastChild;
    setTimeout(() => {
      if (s !== session || !tag.classList.contains('bad')) return;
      tag.className = 'ok';
      tag.textContent = '[RÉPARÉ]';
      errFixed++;
      majErr();
    }, alea(600, 1300));
  }

  // Ouverture / fermeture d'une fenêtre avec un petit effet de scintillement
  function ouvrirFenetre(f) {
    f.style.display = 'block';
    f.animate([
      { opacity: 0, transform: 'scale(0.9, 0.04)', filter: 'hue-rotate(90deg) brightness(2)' },
      { opacity: 1, transform: 'scale(1.04, 0.04)', filter: 'brightness(2.4)', offset: 0.25 },
      { opacity: 0.5, transform: 'scale(1, 1.05)', filter: 'hue-rotate(-60deg)', offset: 0.55 },
      { opacity: 1, transform: 'scale(1, 1)', filter: 'none', offset: 0.7 },
      { opacity: 0.6, offset: 0.82 },
      { opacity: 1, transform: 'none', filter: 'none' }
    ], { duration: 520 });
    // Le titre se "décode", un petit bip, et chaque fenêtre a son propre rythme de glitch

  async function lancerReboot(s) {
    etat = 'reboot';
    // Tout s'adapte à la taille de l'écran
    const ech = Math.min(1, window.innerWidth / 1480, window.innerHeight / 940);
    rbScene.style.transform = 'scale(' + ech.toFixed(3) + ')';
    [rbMain, rbRoot, rbErr, rbNet, rbMem, rbCle].forEach((f) => { f.style.display = 'none'; });
    [rebootCadre, rootCadre, errCadre, netCadre, memCadre, cleCadre].forEach((c) => { c.style.animation = ''; c.style.background = ''; });
    rebootFill.style.width = '0%';
    rebootPct.textContent = '0%';
    rebootSous.textContent = ETAPES_REBOOT[0][1];
    rebootTitre.textContent = 'RÉINITIALISATION';
    rebootMeta.textContent = 'SESSION ' + hex(4) + '-' + hex(4) + '  //  ACCÈS ROOT';
    rootTitre.textContent = 'ACCÈS ROOT';
    rootSous.textContent = 'capri@night-city:~#  ÉLÉVATION DES PRIVILÈGES...';
    errTitre.textContent = "JOURNAL D'ERREURS";
    netTitre.textContent = 'RÉSEAU NETWATCH';
    memTitre.textContent = 'MÉMOIRE';
    cleTitre.textContent = 'DÉCHIFFREMENT';
    rebootLog.innerHTML = '';
    errLog.innerHTML = '';
    cleLog.innerHTML = '';
    indexLog = 0; errTotal = 0; errFixed = 0; errCrit = 0; rootFermee = false;
    majErr(); majJauges(0); majRoot(0); majNet(0); majMem(0); majCle(0);
    rebootT0 = performance.now();
    rebootEl.style.display = 'block';
    debutHack();
    ouvrirFenetre(rbMain);
    ajouterLog();

    const ouv = { net: false, err: false, root: false, mem: false, cle: false };
    const fini = { net: false, err: false, root: false, mem: false, cle: false };
    const prog = (p, a, b) => Math.min(100, Math.max(0, (p - a) / (b - a) * 100));
    let p = 0;
    while (p < 100) {
      await wait(alea(100, 240));
      if (s !== session) return;
      if (Math.random() < 0.1) {                 // de temps en temps la barre se bloque un instant
        await wait(alea(250, 600));
        if (s !== session) return;
      }
      p = Math.min(100, p + alea(1.8, 5.5));
      const n = Math.floor(p);
      rebootFill.style.width = n + '%';
      rebootPct.textContent = n + '%';
      for (const [seuil, txt] of ETAPES_REBOOT) if (n >= seuil) rebootSous.textContent = txt;
      majJauges(p);
      majAlerte(p);
      ajouterLog();

      // Chaque fenêtre s'ouvre à son moment
      if (!ouv.net && p >= OUV_NET) { ouv.net = true; ouvrirFenetre(rbNet); }
      if (!ouv.err && p >= OUV_ERR) { ouv.err = true; ouvrirFenetre(rbErr); }
      if (!ouv.root && p >= OUVERTURE_ROOT) { ouv.root = true; ouvrirFenetre(rbRoot); }
      if (!ouv.mem && p >= OUV_MEM) { ouv.mem = true; ouvrirFenetre(rbMem); }
      if (!ouv.cle && p >= OUV_CLE) { ouv.cle = true; ouvrirFenetre(rbCle); }

      // RÉSEAU
      if (ouv.net && !fini.net) {
        const pr = prog(p, OUV_NET, FIN_NET);
        majNet(pr);
        if (pr >= 100) { fini.net = true; finirFenetre(rbNet, netCadre, netTitre, 'RÉSEAU : RELAIS CONTOURNÉS', s); }
      }
      // ACCÈS ROOT
      if (ouv.root && !fini.root) {
        const pr = prog(p, OUVERTURE_ROOT, FIN_ROOT);
        majRoot(pr);
        if (pr >= 100) { fini.root = true; finirRoot(s); }
      }
      // MÉMOIRE
      if (ouv.mem && !fini.mem) {
        const pr = prog(p, OUV_MEM, FIN_MEM);
        majMem(pr);
        if (pr >= 100) { fini.mem = true; finirFenetre(rbMem, memCadre, memTitre, 'MÉMOIRE : OK', s); }
      }
      // DÉCHIFFREMENT
      if (ouv.cle && !fini.cle) {
        const pr = prog(p, OUV_CLE, FIN_CLE);
        majCle(pr);
        ajouterHex();
        if (pr >= 100) { fini.cle = true; finirFenetre(rbCle, cleCadre, cleTitre, 'DÉCHIFFREMENT TERMINÉ', s); }
      }
      // JOURNAL D'ERREURS
      if (ouv.err && !fini.err) {
        if (p >= FIN_ERR) {
          fini.err = true;
          errLog.querySelectorAll('.bad').forEach((t) => { t.className = 'ok'; t.textContent = '[RÉPARÉ]'; });
          errFixed = errTotal;
          majErr();
          finirFenetre(rbErr, errCadre, errTitre, "JOURNAL D'ERREURS : TOUT EST RÉPARÉ", s);
        } else if (Math.random() < 0.6) {
          ajouterErreur(s);
        }
      }
    }

    // Terminé : la fenêtre principale passe au vert (les autres ont déjà fini, chacune à son tour)
    majJauges(100);
    rebootTitre.textContent = 'RÉINITIALISATION TERMINÉE';
    rebootSous.textContent = 'CAPRI // ACCÈS ACCORDÉ';
    majAlerte(100);
    rebootCadre.style.animation = 'none';
    rebootCadre.style.background = 'var(--vert)';
    await wait(1500);
    if (s !== session) return;
    for (const f of [rbRoot, rbErr, rbNet, rbMem, rbCle]) {   // au cas où une fenêtre n'aurait pas encore fermé
      if (f.style.display !== 'none') { fermerFenetre(f); await wait(150); }
    }
    await fermerFenetre(rbMain);
    if (s !== session) return;
    await finHack();
    if (s !== session) return;
    rebootEl.style.display = 'none';
    afficherUSB(false);
    await wait(250);
    if (s !== session) return;
    reapparaitre(s);
  }

  // Deux ou trois très grands éclairs blancs tombent presque d'un coup du haut de l'écran, sur son point de retour
  const NB_GRANDS_ECLAIRS = 3;      // 2 ou 3 : nombre de grands éclairs
  const DECALAGE_ECLAIRS = 90;      // temps entre deux éclairs (ms) : plus petit = ils tombent presque en même temps
  // Les couleurs de Capri (les mêmes que sa traînée de code) : rose, vert, et blanc avec une lueur rose
  // Chaque paire = [couleur de l'éclair, couleur de sa lueur]. Le 1er éclair prend la 1re paire, etc.
  const COULEURS_RETOUR = [['#fb116e', '#fb116e'], ['#01ec54', '#01ec54'], ['#ffffff', '#fb116e']];
  // Un flash de couleur qui éclaire tout l'écran un instant (force = de 0 à 1)
  function flashBlanc(duree, force, couleur = '#ffffff') {
    const f = document.createElement('div');
    f.style.cssText = 'position:fixed;inset:0;z-index:96;pointer-events:none;background:' + couleur;
    document.body.appendChild(f);
    f.animate([{ opacity: 0 }, { opacity: force, offset: 0.15 }, { opacity: 0 }], { duration: duree }).onfinish = () => f.remove();
  }
  async function grandsEclairs(x, bas, s) {
    for (let i = 0; i < NB_GRANDS_ECLAIRS; i++) {
      setTimeout(() => {
        if (s !== session) return;
        const xi = x + (i === 0 ? 0 : alea(-170, 170));    // le premier tombe pile sur elle, les autres autour
        const [col, lueur] = COULEURS_RETOUR[i % COULEURS_RETOUR.length];
        eclair(xi + alea(-120, 120), -10, xi, bas, {
          couleur: col, halo: lueur, coeur: '#ffffff',
          epaisseur: 6, duree: 800, descente: 70,
          rugosite: 0.4, pas: 8, branches: 0.09, echelleBr: 1.3
        });
        impact(xi, bas, true);
        flashBlanc(220, 0.2, lueur);
      }, i * DECALAGE_ECLAIRS);
    }
    await wait((NB_GRANDS_ECLAIRS - 1) * DECALAGE_ECLAIRS + 160);
  }

  // Capri revient : les éclairs convergent sur un point, et elle apparaît d'un coup, assise
  async function reapparaitre(s) {
    etat = 'reboot';
    ay = 0; cibleAy = 0; rot = 0; phi = 0; omega = 0;
    walker.style.transformOrigin = '';
    await setPoseAssise();
    if (s !== session) return;
    await wait(60);
    if (s !== session) return;
    const w = sprite.offsetWidth;
    ax = alea(w, Math.max(w, window.innerWidth - 2 * w));
    adir = 1;
    majTransform(1);
    walker.style.opacity = 0;
    sprite.style.transform = '';

    // Les grands éclairs tombent sur l'endroit où elle va apparaître
    const x = ax + w / 2, bas = window.innerHeight - 2;
    retirerPilier();                       // la colonne de lumière de la puce disparaît
    await grandsEclairs(x, bas, s);
    if (s !== session) return;

    // Gros flash, et elle est là d'un coup
    flashBlanc(350, 0.4, '#fb116e');
    impact(x, bas);
    walker.style.opacity = 1;
    walker.style.pointerEvents = '';
    walker.animate([{ filter: 'brightness(5)' }, { filter: 'none' }], { duration: 300 });

    etat = 'parle';
    raf = requestAnimationFrame(boucle);
    const fini = await direPhrase(PHRASES_REBOOT, 2500, 800);
    if (!fini || s !== session) return;

    adir = Math.random() < 0.5 ? -1 : 1;
    const ok = await transformer(MARCHE, s);
    if (!ok) return;
    etat = 'marche';
    const t = performance.now();
    finEtat = t + alea(4000, 9000);
    prochaineEscapade = t + alea(ESCAPADE_MIN, ESCAPADE_MAX);
    prochaineBulle = t + alea(BULLE_MIN, BULLE_MAX);
  }

  // Attraper la puce avec la souris, et la glisser dans un port
  puceEl.addEventListener('mouseenter', () => { survolPuce = true; majClic(); });
  puceEl.addEventListener('mouseleave', () => { survolPuce = false; majClic(); });
  puceEl.addEventListener('contextmenu', (e) => { e.preventDefault(); ouvrirMenu(e.clientX, e.clientY); });
  puceEl.addEventListener('pointerdown', (e) => {
    if (e.button !== 0 || !enAnim || etat !== 'puce' || !puceActive) return;
    if (puceMode === 'entre' || puceMode === 'tenue') return;
    e.preventDefault();
    puceEl.setPointerCapture(e.pointerId);
    const dx = puceX - e.clientX, dy = puceY - e.clientY; // la puce ne "saute" pas vers le curseur
    let lx = e.clientX, ly = e.clientY, lt = performance.now(), vx = 0, vy = 0;
    puceMode = 'tenue';
    puceVX = 0; puceVY = 0;
    dernierFragX = puceX; dernierFragY = puceY;
    puceTenue = true;
    puceEl.classList.add('tenue');
    majClic();

    const bouge = (m) => {
      const t = performance.now(), d = Math.max(0.001, (t - lt) / 1000);
      vx += (((m.clientX - lx) / d) - vx) * 0.4;
      vy += (((m.clientY - ly) / d) - vy) * 0.4;
      lx = m.clientX; ly = m.clientY; lt = t;
      puceX = m.clientX + dx;
      puceY = m.clientY + dy;
      portSurvole = portSous(m.clientX, m.clientY);   // le port s'allume quand on est dessus
      surlignerPort(portSurvole);
    };
    const fin = () => {
      puceEl.removeEventListener('pointermove', bouge);
      puceEl.removeEventListener('pointerup', fin);
      puceEl.removeEventListener('pointercancel', fin);
      puceTenue = false;
      puceEl.classList.remove('tenue');
      survolPuce = puceEl.matches(':hover');
      majClic();
      if (performance.now() - lt > 80) { vx = 0; vy = 0; } // la souris était immobile
      const port = portSous(lx, ly);
      if (port) {
        inserer(port);
      } else {                                              // pas dans un port : elle retombe au sol
        portSurvole = null;
        surlignerPort(null);
        puceVX = borner(vx, -1500, 1500);
        puceVY = borner(vy, -1500, 1500);
        puceMode = 'vol';
      }
    };
    puceEl.addEventListener('pointermove', bouge);
    puceEl.addEventListener('pointerup', fin);
    puceEl.addEventListener('pointercancel', fin);
  });

  // ===== Foudre réaliste =====

  // Ligne brisée entre deux points (déplacement du point milieu, de plus en plus fin)
  function zigzag(x1, y1, x2, y2, rugosite, pas) {
    const pts = [[x1, y1]];
    (function sub(ax_, ay_, bx_, by_) {
      const len = Math.hypot(bx_ - ax_, by_ - ay_);
      if (len <= pas) { pts.push([bx_, by_]); return; }
      const nx = -(by_ - ay_) / len, ny = (bx_ - ax_) / len;
      const d = (Math.random() - 0.5) * len * rugosite;
      const mx = (ax_ + bx_) / 2 + nx * d, my = (ay_ + by_) / 2 + ny * d;
      sub(ax_, ay_, mx, my);
      sub(mx, my, bx_, by_);
    })(x1, y1, x2, y2);
    return pts;
  }

  // Tronc principal + branches qui partent vers le bas
  function construire(x1, y1, x2, y2, o) {
    const segments = [];
    const principal = zigzag(x1, y1, x2, y2, o.rugosite, o.pas);
    segments.push({ pts: principal, l: 1, delai: 0 });
    let nb = 0;
    for (let i = 5; i < principal.length - 8 && nb < 7; i++) {
      if (Math.random() < o.branches) {
        nb++;
        const [bx, by] = principal[i];
        const ang = Math.PI / 2 + (Math.random() < 0.5 ? -1 : 1) * alea(0.35, 1.0);
        const L = alea(70, 220) * o.echelleBr;
        segments.push({
          pts: zigzag(bx, by, bx + Math.cos(ang) * L, by + Math.sin(ang) * L, 0.5, o.pas),
          l: 0.45,
          delai: i / principal.length
        });
      }
    }
    return segments;
  }

  // Dessine un éclair : il descend très vite, puis scintille comme un vrai
  // o : couleur (trait), halo (lueur), epaisseur, duree, descente, rugosite, pas, branches, echelleBr
  function eclair(x1, y1, x2, y2, o) {
    const segs = construire(x1, y1, x2, y2, o);

    // Boîte englobante : le svg ne couvre que l'éclair (plus léger pour l'ordinateur)
    let minx = 1e9, miny = 1e9, maxx = -1e9, maxy = -1e9;
    segs.forEach((s) => s.pts.forEach((p) => {
      minx = Math.min(minx, p[0]); maxx = Math.max(maxx, p[0]);
      miny = Math.min(miny, p[1]); maxy = Math.max(maxy, p[1]);
    }));
    const pad = 30;
    const W = maxx - minx + pad * 2, H = maxy - miny + pad * 2;

    const svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('viewBox', (minx - pad) + ' ' + (miny - pad) + ' ' + W + ' ' + H);
    svg.style.cssText = 'position:fixed;pointer-events:none;z-index:98;overflow:visible;' +
      'left:' + (minx - pad) + 'px;top:' + (miny - pad) + 'px;width:' + W + 'px;height:' + H + 'px;' +
      'filter:drop-shadow(0 0 3px ' + o.halo + ') drop-shadow(0 0 10px ' + o.halo + ')';

    const trace = (s, couleur, largeur, opacite) => {
      const p = document.createElementNS(NS, 'path');
      p.setAttribute('d', 'M' + s.pts.map((q) => q[0].toFixed(1) + ',' + q[1].toFixed(1)).join('L'));
      p.setAttribute('fill', 'none');
      p.setAttribute('stroke', couleur);
      p.setAttribute('stroke-width', largeur);
      p.setAttribute('stroke-linecap', 'round');
      p.setAttribute('stroke-linejoin', 'round');
      p.setAttribute('pathLength', '1');
      p.setAttribute('opacity', opacite);
      p.style.strokeDasharray = '1';
      svg.appendChild(p);
      // L'éclair se "dessine" du haut vers le bas en un clin d'œil
      p.animate(
        [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }],
        { duration: o.descente * (s.l === 1 ? 1 : 0.5), delay: s.delai * o.descente, fill: 'both', easing: 'linear' }
      );
    };

    segs.forEach((s) => {
      const e = o.epaisseur * s.l;
      trace(s, o.halo, e * 3.5, 0.45);   // lueur large
      trace(s, o.couleur, e * 1.6, 0.9); // trait coloré
      trace(s, o.coeur || '#fff', e * 0.8, 1);      // cœur blanc
    });

    document.body.appendChild(svg);

    // Scintillement : plusieurs réamorçages, comme un vrai éclair
    svg.animate([
      { opacity: 1, offset: 0 },
      { opacity: 1, offset: 0.12 },
      { opacity: 0.25, offset: 0.2 },
      { opacity: 1, offset: 0.3 },
      { opacity: 0.35, offset: 0.42 },
      { opacity: 0.85, offset: 0.52 },
      { opacity: 0.15, offset: 0.7 },
      { opacity: 0, offset: 1 }
    ], { duration: o.duree, fill: 'forwards' }).onfinish = () => svg.remove();
  }

  // Petits carrés qui partent dans tous les sens (avec gravité)
  // o : couleurs, n, vmin, vmax, tailleMin, tailleMax, angleMin, angleMax, duree (ms) ou sol:true
  function particules(x, y, o) {
    const G = 1600; // gravité (pixels par seconde au carré)
    for (let i = 0; i < o.n; i++) {
      const a = alea(o.angleMin, o.angleMax), v = alea(o.vmin, o.vmax);
      const vx = Math.cos(a) * v, vy = Math.sin(a) * v;
      const t = alea(o.tailleMin, o.tailleMax);
      const el = document.createElement('div');
      el.style.cssText = 'position:fixed;pointer-events:none;z-index:97;will-change:transform,opacity;' +
        'left:' + (x - t / 2) + 'px;top:' + (y - t / 2) + 'px;width:' + t + 'px;height:' + t + 'px;' +
        'background:' + o.couleurs[Math.floor(Math.random() * o.couleurs.length)];
      document.body.appendChild(el);

      // Au sol : le carré retombe à la hauteur de départ. Sinon : durée fixe.
      const D = o.sol ? Math.min(1.1, Math.max(0.25, 2 * Math.abs(vy) / G)) : (o.duree / 1000) * alea(0.7, 1);
      const rot = alea(-720, 720);
      const N = 14, kf = [];
      for (let k = 0; k <= N; k++) {
        const s = (k / N) * D;
        kf.push({
          transform: 'translate(' + (vx * s).toFixed(1) + 'px,' + (vy * s + 0.5 * G * s * s).toFixed(1) + 'px) rotate(' + (rot * s).toFixed(0) + 'deg)',
          opacity: k > N - 3 ? (N - k) / 3 : 1
        });
      }
      el.animate(kf, { duration: D * 1000, easing: 'linear' }).onfinish = () => el.remove();
    }
  }

  // Impact du tonnerre sur le sol : halo, onde de choc, carrés qui partent partout
  function impact(x, bas, sansBlocs) {
    const halo = document.createElement('div');
    halo.style.cssText = 'position:fixed;pointer-events:none;z-index:97;border-radius:50%;' +
      'left:' + (x - 110) + 'px;top:' + (bas - 34) + 'px;width:220px;height:68px;' +
      'background:radial-gradient(ellipse, rgba(255,255,255,0.95) 0, rgba(190,215,255,0.55) 35%, transparent 70%)';
    document.body.appendChild(halo);
    halo.animate(
      [{ opacity: 1, transform: 'scale(0.4)' }, { opacity: 0.8, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(1.3)' }],
      { duration: 380, easing: 'ease-out' }
    ).onfinish = () => halo.remove();

    const onde = document.createElement('div');
    onde.style.cssText = 'position:fixed;pointer-events:none;z-index:97;border-radius:50%;' +
      'border:2px solid rgba(255,255,255,0.85);' +
      'left:' + (x - 20) + 'px;top:' + (bas - 12) + 'px;width:40px;height:12px';
    document.body.appendChild(onde);
    onde.animate(
      [{ opacity: 0.9, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(8)' }],
      { duration: 360, easing: 'ease-out' }
    ).onfinish = () => onde.remove();

    if (!sansBlocs) particules(x, bas - 2, {
      couleurs: ['#ffffff', '#ffffff', '#e6f0ff', '#9fb4cc', '#5b6b80', '#2b3340'],
      n: 36, vmin: 250, vmax: 800, tailleMin: 3, tailleMax: 9,
      angleMin: -Math.PI * 0.95, angleMax: -Math.PI * 0.05, sol: true
    });
  }

  // Mini-éclairs de couleurs différentes qui frappent Capri
  function frappes() {
    const r = sprite.getBoundingClientRect();
    for (let i = 0; i < 9; i++) {
      setTimeout(() => {
        const c = PALETTE[Math.floor(Math.random() * PALETTE.length)];
        const cx = r.left + r.width * alea(0.2, 0.8);
        const cy = r.top + r.height * alea(0.15, 0.9);
        const haut = Math.max(-10, r.top - alea(160, 380));
        eclair(cx + alea(-140, 140), haut, cx, cy, {
          couleur: c, halo: c, epaisseur: alea(1.6, 2.8),
          duree: alea(300, 450), descente: 45,
          rugosite: 0.45, pas: 5, branches: 0.06, echelleBr: 0.4
        });
        particules(cx, cy, {
          couleurs: [c, c, '#ffffff'], n: 7, vmin: 120, vmax: 380,
          tailleMin: 2, tailleMax: 5, angleMin: -Math.PI, angleMax: Math.PI, duree: 420
        });
        // Capri s'illumine à chaque impact
        walker.animate(
          [{ filter: 'none' }, { filter: 'brightness(1.9) drop-shadow(0 0 12px ' + c + ')' }, { filter: 'none' }],
          { duration: 160 }
        );
      }, i * 28 + alea(0, 25));
    }
  }

  // ===== Écrasement / retour à la forme (rapide) =====
  const ECRASE = 'scale(1.5, 0.06)';
  async function ecrase() {
    const a = sprite.animate(
      [{ transform: 'scale(1,1)' }, { transform: ECRASE }],
      { duration: 100, easing: 'ease-in', fill: 'forwards' }
    );
    await a.finished;
    sprite.style.transform = ECRASE;
    a.cancel();
  }
  async function reforme(duree) {
    await sprite.animate([
      { transform: ECRASE },
      { transform: 'scale(1.2, 0.6)', offset: 0.35 },
      { transform: 'scale(0.94, 1.08)', offset: 0.7 },
      { transform: 'scale(1, 1)' }
    ], { duration: duree, easing: 'ease-out' }).finished;
    sprite.style.transform = '';
  }

  // Changement d'image : mini-éclairs, écrasement, nouvelle image, retour à la forme
  async function transformer(n, s) {
    frappes();
    await wait(150);
    if (s !== session) return false;
    await ecrase();
    if (s !== session) return false;
    setPose(n);
    await wait(20);
    if (s !== session) return false;
    ax = Math.min(ax, Math.max(0, window.innerWidth - sprite.offsetWidth));
    await reforme(340);
    return s === session;
  }

  // Elle s'assoit au sol, dit sa phrase, puis se relève et repart marcher
  async function parlerAssise(s) {
    frappes();
    await wait(150);
    if (s !== session) return;
    await ecrase();
    if (s !== session) return;
    await setPoseAssise();
    if (s !== session) return;
    await wait(30);
    if (s !== session) return;
    ax = borner(ax, 0, Math.max(0, window.innerWidth - sprite.offsetWidth));
    await reforme(340);
    if (s !== session) return;

    etat = 'parle';
    const fini = await direPhrase();
    if (!fini || s !== session) return;

    adir = Math.random() < 0.5 ? -1 : 1;
    const ok = await transformer(MARCHE, s);
    if (!ok) return;
    etat = 'marche';
    finEtat = performance.now() + alea(4000, 10000);
    prochaineBulle = performance.now() + alea(BULLE_MIN, BULLE_MAX);
  }

  // ===== Traînée pluie de code (couleurs de Capri) derrière Capri quand on la tient =====
  // Un caractère de code apparaît sur son corps, dérive sur le côté et retombe en s'effaçant
  function glyphe(x, y) {
    const [couleur, lueur] = TRAINEE_PALETTE[Math.floor(Math.random() * TRAINEE_PALETTE.length)];
    const el = document.createElement('div');
    el.textContent = TRAINEE_CARACTERES[Math.floor(Math.random() * TRAINEE_CARACTERES.length)];
    el.style.cssText = 'position:absolute;pointer-events:none;white-space:pre;' +
      'font-family:Consolas,"Courier New",monospace;font-weight:bold;' +
      'left:' + x + 'px;top:' + y + 'px;font-size:' + alea(10, 15).toFixed(0) + 'px;' +
      'color:' + couleur + ';text-shadow:0 0 6px ' + lueur + ';';
    anim.insertBefore(el, walker); // derrière Capri
    const dx = alea(-14, 14), chute = alea(30, 70);
    el.animate([
      { opacity: 0.95, transform: 'translate(0px,0px)' },
      { opacity: 0, transform: 'translate(' + dx.toFixed(1) + 'px,' + chute.toFixed(1) + 'px)' }
    ], { duration: TRAINEE_DUREE * alea(0.8, 1.2), easing: 'ease-in' }).onfinish = () => el.remove();
  }

  // Appelée à chaque image pendant qu'on tient Capri
  function emettreTrainee(now, bx, by) {
    histCorps.push({ x: bx, y: by, t: now });
    while (histCorps.length > 1 && now - histCorps[0].t > 120) histCorps.shift();
    if (now < prochaineTrainee || histCorps.length < 2) return;
    const a = histCorps[0];
    const duree = (now - a.t) / 1000;
    if (Math.hypot(bx - a.x, by - a.y) / duree < TRAINEE_VITESSE) return;
    prochaineTrainee = now + TRAINEE_PAUSE;
    const n = TRAINEE_NOMBRE_MIN + Math.floor(Math.random() * (TRAINEE_NOMBRE_MAX - TRAINEE_NOMBRE_MIN + 1));
    for (let i = 0; i < n; i++) glyphe(bx + alea(-42, 42), by + alea(-52, 52)); // zone un peu plus large : ça se répartit mieux
  }

  // Des petits fichiers qui giclent d'un point (avec gravité)
  const LENTEUR_FICHIERS = 1.4;   // 1 = comme avant ; plus grand = les fichiers volent plus lentement
  function fichiers(x, y, n) {
    const G = 1600;
    for (let i = 0; i < n; i++) {
      const a = alea(-Math.PI * 0.97, -Math.PI * 0.03), v = alea(320, 950);
      const vx = Math.cos(a) * v, vy = Math.sin(a) * v;
      const w = alea(16, 30), h = w * 1.3;
      const col = COULEURS_FICHIERS[Math.floor(Math.random() * COULEURS_FICHIERS.length)];
      const el = document.createElement('div');
      el.style.cssText = 'position:fixed;pointer-events:none;z-index:97;will-change:transform,opacity;' +
        'left:' + (x - w / 2) + 'px;top:' + (y - h / 2) + 'px;width:' + w + 'px;height:' + h + 'px;' +
        'background-color:' + col + ';' +
        'background-image:repeating-linear-gradient(0deg, rgba(0,0,0,0.45) 0 2px, transparent 2px 5px);' +
        'background-size:100% 60%;background-repeat:no-repeat;background-position:0 100%;' +
        'clip-path:polygon(0 0, 68% 0, 100% 26%, 100% 100%, 0 100%)';
      document.body.appendChild(el);
      // Même trajectoire qu'avant, mais parcourue plus lentement
      const D = Math.min(1.4, Math.max(0.4, 2 * Math.abs(vy) / G));
      const rot = alea(-540, 540);
      const N = 16, kf = [];
      for (let k = 0; k <= N; k++) {
        const s = (k / N) * D;
        kf.push({
          transform: 'translate(' + (vx * s).toFixed(1) + 'px,' + (vy * s + 0.5 * G * s * s).toFixed(1) + 'px) rotate(' + (rot * s).toFixed(0) + 'deg)',
          opacity: k > N - 3 ? (N - k) / 3 : 1
        });
      }
      el.animate(kf, { duration: D * 1000 * LENTEUR_FICHIERS, easing: 'linear' }).onfinish = () => el.remove();
    }
  }

  // Gerbe à l'impact : des éclairs qui partent dans tous les sens, et des fichiers qui giclent
  function explosionImpact(x, y) {
    for (let i = 0; i < NB_ECLAIRS_IMPACT; i++) {
      setTimeout(() => {
        const c = PALETTE[Math.floor(Math.random() * PALETTE.length)];
        const ang = -Math.PI * alea(0.03, 0.97);   // vers le haut, à gauche et à droite
        const len = alea(90, 260);
        eclair(x, y - 2, x + Math.cos(ang) * len, y - 2 + Math.sin(ang) * len, {
          couleur: c, halo: c, epaisseur: alea(1.8, 3),
          duree: alea(320, 480), descente: 55,
          rugosite: 0.5, pas: 5, branches: 0, echelleBr: 0
        });
      }, i * 18);
    }
    fichiers(x, y - 4, NB_FICHIERS);
  }

  // ===== Bug : si on la secoue trop longtemps, elle déraille, disparaît et lâche une puce =====
  const SECOUSSE_VITESSE = 700;   // vitesse minimale de la souris (pixels par seconde) pour compter comme une "secousse"
  const SECOUSSE_DUREE = 0.7;     // secondes de secousses (cumulées) avant que ça puisse bugger : plus petit = plus rapide
  const CHANCE_BUG = 1.0;         // chance de bug par seconde une fois la durée atteinte (1.0 = ça bugge vite ; 0.3 = plus rare)
  const SEQUENCES_BUG = [         // chaque bug choisit une série au hasard : les phrases s'enchaînent
    ["Il se passe quelque chose...", "Choom... ça déconne...", "Je... je disparais ?!"],
    ["Hé... j'ai un truc bizarre...", "Mes implants s'affolent !", "Je me sens... flatline..."],
    ["Euh... c'est normal, ça ?", "Mon neuro-link grésille !", "Choom, aide-moi... !"],
    ["Qu'est-ce qui m'arrive ?!", "Tout devient blanc...", "Ça bug, ça bug, ça bug !"],
    ["J'ai comme un... glitch...", "Mon cyberware surchauffe !", "Reboot... il me faut un reboot !"]
  ];
  let secousse = 0;               // temps de secousses accumulé pendant qu'on la tient (secondes)

  async function bugCapri(s) {
    etat = 'bug';                  // elle arrête de suivre la souris
    secousse = 0;
    tenue = false; survolCapri = false;
    walker.style.pointerEvents = 'none';
    majClic();
    cacherBulle();

    // Elle grésille : son image saute et change de couleur
    const jit = sprite.animate([
      { transform: 'translate(0px, 0px)', filter: 'none' },
      { transform: 'translate(-7px, 2px) skewX(8deg)', filter: 'hue-rotate(90deg) brightness(1.6)', offset: 0.25 },
      { transform: 'translate(6px, -3px)', filter: 'invert(1)', offset: 0.5 },
      { transform: 'translate(-3px, 4px) skewX(-6deg)', filter: 'hue-rotate(200deg)', offset: 0.75 },
      { transform: 'translate(0px, 0px)', filter: 'none' }
    ], { duration: 240, iterations: Infinity, easing: 'steps(1)' });

    // Des éclairs de couleurs la frappent pendant tout le bug
    glitchEcran(1200);
    frappes();
    const salves = setInterval(() => { if (s === session && etat === 'bug') frappes(); }, 380);
    const flashs = setInterval(() => {
      if (s === session && etat === 'bug') flashBlanc(160, 0.12, PALETTE[Math.floor(Math.random() * PALETTE.length)]);
    }, 700);
    const arreter = () => { clearInterval(salves); clearInterval(flashs); jit.cancel(); };

    // Elle dit plusieurs phrases à la suite
    const serie = SEQUENCES_BUG[Math.floor(Math.random() * SEQUENCES_BUG.length)];
    for (let i = 0; i < serie.length; i++) {
      const ok = await direPhrase([serie[i]], 750, 250);
      if (!ok || s !== session) { arreter(); return; }
      if (i === 1) glitchEcran(900);
    }

    // Le grand bug : salve finale, l'écran déraille, et elle disparaît
    glitchEcran(700);
    frappes();
    flashBlanc(350, 0.45, '#ffffff');
    await wait(260);
    if (s !== session) { arreter(); return; }
    arreter();
    const h = HAUTEUR_ATTRAPEE * ECHELLE;
    const cx = curX + Math.sin(phi) * h * 0.5, cy = curY + Math.cos(phi) * h * 0.5;
    walker.style.opacity = 0;
    particules(cx, cy, {
      couleurs: PALETTE.concat(['#ffffff']), n: 26, vmin: 150, vmax: 520,
      tailleMin: 2, tailleMax: 6, angleMin: -Math.PI, angleMax: Math.PI, duree: 600
    });

    // La puce apparaît à sa place et retombe : il faut la glisser dans un port USB
    cancelAnimationFrame(raf);
    etat = 'puce';
    rot = 0; phi = 0; omega = 0;
    walker.style.transformOrigin = '';
    lancerPuce(cx, cy, true);
    await wait(900);
    if (s !== session) return;
    puceSession = s;
    puceEl.style.pointerEvents = '';
    afficherUSB(true);
  }

  // ===== Atterrissage : elle s'écrase comme une crêpe, se plaint, puis repart =====
  // (parfois, une puce jaillit avec les fichiers : voir la section "La puce" plus haut)
  async function atterrir(s) {
    etat = 'ecrasee';
    ay = 0; rot = 0; phi = 0; omega = 0;
    walker.style.transformOrigin = '';
    ax = borner(ax, 0, Math.max(0, window.innerWidth - sprite.offsetWidth));
    const xi = ax + sprite.offsetWidth / 2, yi = window.innerHeight - 2;
    impact(xi, yi, true);
    explosionImpact(xi, yi);
    const avecPuce = Math.random() < CHANCE_PUCE;   // une chance sur quelques-unes qu'une puce tombe
    if (avecPuce) lancerPuce(xi, yi);

    // Écrasement
    const a = sprite.animate([
      { transform: 'scale(1, 1)' },
      { transform: 'scale(1.5, 0.2)', offset: 0.5 },
      { transform: CREPE }
    ], { duration: 240, easing: 'ease-out', fill: 'forwards' });
    await a.finished.catch(() => {});
    if (s !== session) return;
    sprite.style.transform = CREPE;
    a.cancel();

    // Elle se plaint
    const fini = await direPhrase(PHRASES_AIE, DUREE_CREPE, 600);
    if (!fini || s !== session) return;

    // Avec la puce : la foudre la fait disparaître, il faut glisser la puce dans un port USB
    if (avecPuce) { await sequencePuce(s); return; }

    // Éclairs, puis elle reprend forme et repart marcher
    frappes();
    await wait(200);
    if (s !== session) return;
    adir = Math.random() < 0.5 ? -1 : 1;
    setPose(MARCHE);
    await wait(20);
    if (s !== session) return;
    ax = borner(ax, 0, Math.max(0, window.innerWidth - sprite.offsetWidth));
    await sprite.animate([
      { transform: CREPE },
      { transform: 'scale(1.1, 0.7)', offset: 0.35 },
      { transform: 'scale(0.94, 1.08)', offset: 0.7 },
      { transform: 'scale(1, 1)' }
    ], { duration: 340, easing: 'ease-out' }).finished.catch(() => {});
    sprite.style.transform = '';
    if (s !== session) return;
    etat = 'marche';
    const t = performance.now();
    finEtat = t + alea(4000, 9000);
    prochaineEscapade = t + alea(ESCAPADE_MIN, ESCAPADE_MAX);
    prochaineBulle = t + alea(BULLE_MIN, BULLE_MAX);
  }

  // ===== Lancement de la balade =====
  async function animer() {
    call.style.display = 'none';
    ipcRenderer.send('mode', 'anim');
    enAnim = true;
    const s = ++session;
    await wait(250);
    if (s !== session) return;
    anim.style.display = 'block';
    document.body.classList.add('enAnim');
    montrerBoutonDiscussion(); // le bouton PARLER et les ports USB sont rentrés : ils glissent à leur place avec le dock
    afficherUSB(false);
    demarrerBalade(s);
  }

  async function demarrerBalade(s) {
    etat = 'cache';
    cacherBulle();
    ay = 0; cibleAy = 0;   // elle apparaît au sol
    fenetre = null;
    setPose(MARCHE);
    await wait(60);
    if (s !== session) return;
    const w = sprite.offsetWidth;
    ax = alea(w, Math.max(w, window.innerWidth - 2 * w));
    adir = Math.random() < 0.5 ? -1 : 1;
    majTransform(adir * SENS_MARCHE);
    walker.style.opacity = 0;
    sprite.style.transform = ECRASE;

    // Le tonnerre blanc tombe du haut de l'écran jusqu'au sol
    const x = ax + w / 2, bas = window.innerHeight - 2;
    eclair(x + alea(-90, 90), -10, x, bas, {
      couleur: '#dfeaff', halo: 'rgba(190,215,255,0.95)', epaisseur: 3.5,
      duree: 750, descente: 85, rugosite: 0.38, pas: 7, branches: 0.05, echelleBr: 1
    });
    await wait(85);
    if (s !== session) return;

    // Impact : explosion de carrés, et Capri apparaît tout de suite
    impact(x, bas);
    walker.style.opacity = 1;
    walker.animate([{ filter: 'brightness(3)' }, { filter: 'none' }], { duration: 260 });
    await reforme(380);
    if (s !== session) return;

    etat = 'marche';
    finEtat = performance.now() + alea(4000, 9000);
    prochaineEscapade = performance.now() + (escapadeVite ? alea(2500, 4000) : alea(ESCAPADE_MIN, ESCAPADE_MAX));
    escapadeVite = false;
    prochaineBulle = performance.now() + alea(BULLE_MIN, BULLE_MAX);
    raf = requestAnimationFrame(boucle);
  }

  // ===== Capri s'assoit sur une nouvelle fenêtre =====
  // r : { x, y, w, h } = position de la fenêtre dans l'écran (reçue de main.js)

  // Hauteur du bas de Capri (en pixels depuis le haut de l'écran) quand elle est assise sur la fenêtre.
  // Si la fenêtre touche le haut de l'écran (plein écran), elle s'assoit juste en dessous.
  function bordAssise(r, h) {
    return Math.max(r.y, h + 8);
  }

  async function surFenetre(r) {
    if (!enAnim) return;
    const s = ++session;
    cancelAnimationFrame(raf);
    etat = 'cache';
    fenetre = r;
    fermeeEnAttente = false;
    decalageX = null; // première arrivée : place au hasard

    // Capri disparaît de là où elle est, dans une salve de mini-éclairs
    frappes();
    await wait(150);
    if (s !== session) return;
    await ecrase();
    if (s !== session) return;
    walker.style.opacity = 0;

    // On prépare l'image assise
    await setPoseAssise();
    if (s !== session) return;
    await wait(40);
    if (s !== session) return;
    placerEtFrapper(s);
  }

  // De temps en temps : elle disparaît et réapparaît à un autre endroit de la même fenêtre
  async function changerDeCoin() {
    if (!enAnim || !fenetre) return;
    const s = ++session;
    cancelAnimationFrame(raf);
    etat = 'cache';
    frappes();
    await wait(150);
    if (s !== session) return;
    await ecrase();
    if (s !== session) return;
    walker.style.opacity = 0;
    await wait(120);
    if (s !== session) return;
    placerEtFrapper(s);
  }

  // Choisit une place sur le haut de la fenêtre, fait tomber le tonnerre et fait apparaître Capri
  async function placerEtFrapper(s) {
    const r = fenetre;
    const w = sprite.offsetWidth, h = sprite.offsetHeight;

    // Nouvelle place : assez loin de l'ancienne si la fenêtre est assez large
    const ancien = decalageX;
    let nouveau = alea(0.1, 0.9) * r.w - w / 2;
    for (let i = 0; i < 12 && ancien !== null && Math.abs(nouveau - ancien) < r.w * 0.25; i++) {
      nouveau = alea(0.1, 0.9) * r.w - w / 2;
    }
    decalageX = nouveau;

    ax = borner(r.x + decalageX, 0, Math.max(0, window.innerWidth - w));
    const yBas = bordAssise(r, h);
    ay = window.innerHeight - yBas;
    cibleAx = ax; cibleAy = ay;
    majTransform(1);
    sprite.style.transform = ECRASE;

    // Le tonnerre tombe du haut de l'écran sur le haut de la fenêtre
    const x = ax + w / 2;
    eclair(x + alea(-90, 90), -10, x, yBas, {
      couleur: '#dfeaff', halo: 'rgba(190,215,255,0.95)', epaisseur: 3.5,
      duree: 750, descente: 85, rugosite: 0.38, pas: 7, branches: 0.05, echelleBr: 1
    });
    await wait(85);
    if (s !== session) return;

    // Impact, et Capri apparaît assise
    impact(x, yBas);
    walker.style.opacity = 1;
    walker.animate([{ filter: 'brightness(3)' }, { filter: 'none' }], { duration: 260 });
    await reforme(380);
    if (s !== session) return;

    etat = 'assise';
    prochainSaut = performance.now() + alea(SAUT_MIN, SAUT_MAX);
    raf = requestAnimationFrame(boucle);

    // La fenêtre s'est fermée pendant qu'elle arrivait
    if (fermeeEnAttente) { fermeeEnAttente = false; retourAuSol(); }
  }

  // La fenêtre a bougé : Capri la suit
  function deplacerSurFenetre(r) {
    if (etat !== 'assise') { if (fenetre) fenetre = r; return; }
    fenetre = r;
    const w = sprite.offsetWidth, h = sprite.offsetHeight;
    cibleAx = borner(r.x + decalageX, 0, Math.max(0, window.innerWidth - w));
    cibleAy = window.innerHeight - bordAssise(r, h);
  }

  // La fenêtre est fermée : Capri disparaît et revient au sol avec un nouvel éclair
  async function retourAuSol() {
    if (!enAnim) return;
    const s = ++session;
    cancelAnimationFrame(raf);
    etat = 'cache';
    fenetre = null;
    frappes();
    await wait(150);
    if (s !== session) return;
    await ecrase();
    if (s !== session) return;
    walker.style.opacity = 0;
    demarrerBalade(s);
  }

  ipcRenderer.on('fenetre-ouverte', (e, r) => { if (!occupee()) surFenetre(r); });
  ipcRenderer.on('fenetre-bouge', (e, r) => deplacerSurFenetre(r));
  ipcRenderer.on('fenetre-fermee', () => {
    if (!enAnim || occupee()) return;
    if (etat === 'assise') retourAuSol();
    else if (fenetre) fermeeEnAttente = true;
  });

  // ===== Escapade : elle disparaît, puis marche sur une ligne de la grande fenêtre =====
  async function lancerEscapade(s) {
    let ok = false;
    try { ok = await ipcRenderer.invoke('escapade-possible'); } catch (e) {}
    if (s !== session) return;
    if (!ok) {
      prochaineEscapade = performance.now() + alea(4000, 8000);
      etat = 'marche';
      return;
    }
    lignePerdue = false;

    // 1. Elle disparaît dans une salve de mini-éclairs
    frappes();
    await wait(150);
    if (s !== session) return;
    await ecrase();
    if (s !== session) return;
    walker.style.opacity = 0;
    await wait(560); // les éclairs s'éteignent : l'écran est propre pour la capture
    if (s !== session) return;

    // 2. On cherche les lignes de la fenêtre (texte, barres, boutons...)
    let lignes = [];
    try { lignes = await ipcRenderer.invoke('lignes'); } catch (e) {}
    if (s !== session) return;

    setPose(MARCHE);
    await wait(60);
    if (s !== session) return;
    const w = sprite.offsetWidth, h = sprite.offsetHeight;
    const bonnes = lignes.filter((l) => l.y >= h + 6 && l.y <= window.innerHeight - 8 && (l.x2 - l.x1) >= w + 80);

    // Aucune ligne utilisable : elle revient simplement au sol
    if (!bonnes.length) {
      prochaineEscapade = performance.now() + alea(ESCAPADE_MIN, ESCAPADE_MAX);
      cancelAnimationFrame(raf);
      demarrerBalade(s);
      return;
    }

    // 3. Une ligne au hasard (les longues ont plus de chances)
    const total = bonnes.reduce((a, l) => a + (l.x2 - l.x1), 0);
    let t = Math.random() * total;
    let L = bonnes[0];
    for (const l of bonnes) { t -= (l.x2 - l.x1); if (t <= 0) { L = l; break; } }
    ligne = L;
    adir = Math.random() < 0.5 ? -1 : 1;
    ax = alea(L.x1, L.x2 - w);
    ay = window.innerHeight - L.y;
    cibleAy = ay;
    majTransform(adir * SENS_MARCHE);
    sprite.style.transform = ECRASE;

    // 4. Le tonnerre tombe du haut de l'écran sur la ligne, et Capri apparaît dessus
    const x = ax + w / 2;
    eclair(x + alea(-90, 90), -10, x, L.y, {
      couleur: '#dfeaff', halo: 'rgba(190,215,255,0.95)', epaisseur: 3.5,
      duree: 750, descente: 85, rugosite: 0.38, pas: 7, branches: 0.05, echelleBr: 1
    });
    await wait(85);
    if (s !== session) return;
    impact(x, L.y);
    walker.style.opacity = 1;
    walker.animate([{ filter: 'brightness(3)' }, { filter: 'none' }], { duration: 260 });
    await reforme(380);
    if (s !== session) return;

    etat = 'ligne';
    finLigne = performance.now() + alea(LIGNE_MIN, LIGNE_MAX);
    finSous = performance.now() + alea(1500, 3500); // elle marche d'abord un peu
    if (lignePerdue) { lignePerdue = false; etat = 'transition'; quitterLigne(s); }
  }

  // Sur la ligne : passe de la marche à l'assise (ou l'inverse) avec mini-éclairs et écrasement
  async function transformerLigne(assise, s) {
    frappes();
    await wait(150);
    if (s !== session) return false;
    await ecrase();
    if (s !== session) return false;
    if (assise) await setPoseAssise(); else setPose(MARCHE);
    await wait(30);
    if (s !== session) return false;
    // Les pieds restent sur la ligne ; on la garde à l'intérieur de la ligne
    ax = borner(ax, ligne.x1, Math.max(ligne.x1, ligne.x2 - sprite.offsetWidth));
    await reforme(340);
    return s === session;
  }

  // Elle disparaît de la ligne et revient par terre avec un nouvel éclair
  async function quitterLigne(s) {
    ipcRenderer.send('ligne-finie');
    ligne = null;
    frappes();
    await wait(150);
    if (s !== session) return;
    await ecrase();
    if (s !== session) return;
    walker.style.opacity = 0;
    cancelAnimationFrame(raf);
    demarrerBalade(s);
  }

  // Une grande fenêtre est passée devant : elle descend de sa petite fenêtre et fera bientôt une escapade
  ipcRenderer.on('fenetre-grande', () => {
    if (!enAnim || occupee()) return;
    escapadeVite = true;
    if (etat === 'assise') retourAuSol();
    else if (fenetre) fermeeEnAttente = true;
    else prochaineEscapade = Math.min(prochaineEscapade, performance.now() + alea(2500, 4000));
  });

  // La fenêtre sur laquelle elle marchait a bougé, s'est fermée ou a perdu le premier plan
  ipcRenderer.on('ligne-perdue', () => {
    if (!enAnim || occupee()) return;
    if (etat === 'ligne' || etat === 'ligne-assise') { etat = 'transition'; quitterLigne(session); }
    else lignePerdue = true;
  });

  function boucle() {
    const now = performance.now();
    const w = sprite.offsetWidth;
    const s = session;

    if (etat === 'marche') {
      ax += adir * VITESSE; // elle marche tout droit, sans rebond
      // Stop motion : on change d'image toutes les DELAI_MARCHE millisecondes
      if (now > prochaineImage) {
        imageMarche = (imageMarche + 1) % IMAGES_MARCHE.length;
        sprite.src = nomMarche(imageMarche);
        prochaineImage = now + DELAI_MARCHE;
      }
      if (ax < 0) { ax = 0; adir = 1; }
      if (ax > window.innerWidth - w) { ax = window.innerWidth - w; adir = -1; }
      if (now > finEtat) {
        etat = 'transition';
        transformer(POSES[Math.floor(Math.random() * POSES.length)], s).then((ok) => {
          if (!ok) return;
          etat = 'pose';
          finEtat = performance.now() + alea(3000, 7000);
        });
      } else if (now > prochaineEscapade) {
        etat = 'transition';
        lancerEscapade(s);
      } else if (now > prochaineBulle) {
        etat = 'transition';
        parlerAssise(s);
      }
    } else if (etat === 'ligne' || etat === 'ligne-assise') {
      if (now > finLigne) {
        // Fini : elle revient par terre
        etat = 'transition';
        quitterLigne(s);
      } else if (etat === 'ligne') {
        // Elle marche sur sa ligne et fait demi-tour aux extrémités
        ax += adir * VITESSE;
        if (now > prochaineImage) {
          imageMarche = (imageMarche + 1) % IMAGES_MARCHE.length;
          sprite.src = nomMarche(imageMarche);
          prochaineImage = now + DELAI_MARCHE;
        }
        if (ax < ligne.x1) { ax = ligne.x1; adir = 1; }
        if (ax > ligne.x2 - w) { ax = ligne.x2 - w; adir = -1; }
        if (now > finSous) {
          // Elle s'arrête et s'assoit
          etat = 'transition';
          transformerLigne(true, s).then((ok) => {
            if (!ok) return;
            if (lignePerdue) { lignePerdue = false; quitterLigne(s); return; }
            etat = 'ligne-assise';
            finSous = performance.now() + alea(ASSISE_LIGNE_MIN, ASSISE_LIGNE_MAX);
          });
        }
      } else if (now > finSous) {
        // Elle se relève et repart marcher
        etat = 'transition';
        adir = Math.random() < 0.5 ? -1 : 1;
        transformerLigne(false, s).then((ok) => {
          if (!ok) return;
          if (lignePerdue) { lignePerdue = false; quitterLigne(s); return; }
          etat = 'ligne';
          finSous = performance.now() + alea(MARCHE_LIGNE_MIN, MARCHE_LIGNE_MAX);
        });
      }
    } else if (etat === 'pose' && now > finEtat) {
      etat = 'transition';
      adir = Math.random() < 0.5 ? -1 : 1;
      transformer(MARCHE, s).then((ok) => {
        if (!ok) return;
        etat = 'marche';
        finEtat = performance.now() + alea(4000, 10000);
      });
    } else if (etat === 'assise') {
      // Elle reste assise sur sa fenêtre et la suit en douceur si elle bouge
      ax += (cibleAx - ax) * 0.25;
      ay += (cibleAy - ay) * 0.25;
      if (now > prochainSaut) changerDeCoin();
    } else if (etat === 'attrapee') {
      // Elle pend au curseur par les mains et se balance comme un pendule
      const dt = Math.min(0.033, Math.max(0.001, (now - derniereFrame) / 1000));
      derniereFrame = now;
      const h = HAUTEUR_ATTRAPEE * ECHELLE, wA = h * RATIO_ATTRAPEE;
      vs += (((curX - curXAvant) / dt) - vs) * 0.3;    // vitesse de la souris, lissée
      vsY += (((curY - curYAvant) / dt) - vsY) * 0.3;
      curXAvant = curX; curYAvant = curY;
      // Secousses : si tu la secoues fort assez longtemps, elle risque de bugger
      if (Math.hypot(vs, vsY) > SECOUSSE_VITESSE) secousse += dt;
      else secousse = Math.max(0, secousse - dt * 0.5);
      if (secousse > SECOUSSE_DUREE && Math.random() < CHANCE_BUG * dt) bugCapri(s);
      const L = h * 0.55;
      const pas = 4, d = dt / pas;
      for (let i = 0; i < pas; i++) {
        const alpha = -(GRAVITE / L) * Math.sin(phi) - (TRAINEE * vs) / L - AMORTI * omega;
        omega += alpha * d;
        phi += omega * d;
        if (phi > ANGLE_MAX) { phi = ANGLE_MAX; omega *= -0.3; }
        if (phi < -ANGLE_MAX) { phi = -ANGLE_MAX; omega *= -0.3; }
      }
      rot = -phi * 180 / Math.PI;
      ax = curX - PIVOT_X * wA;
      ay = window.innerHeight - curY - h + PIVOT_Y * h;
      // Traînée de fantômes glitch derrière son corps
      emettreTrainee(now, curX + Math.sin(phi) * h * 0.5, curY + Math.cos(phi) * h * 0.5);
      // De temps en temps, elle dit une phrase
      if (etat === 'attrapee' && !bulleActive && now > prochaineBulleAtt) {
        direPhrase(PHRASES_ATTRAPEE, 2200, 700);
        prochaineBulleAtt = now + alea(BULLE_ATT_MIN, BULLE_ATT_MAX);
      }
    } else if (etat === 'chute') {
      // Lâchée : elle garde son élan, tombe au sol et s'écrase
      const dt = Math.min(0.033, Math.max(0.001, (now - derniereFrame) / 1000));
      derniereFrame = now;
      vChute += GRAVITE_CHUTE * dt;
      ay -= vChute * dt;
      ax = borner(ax + vxChute * dt, 0, Math.max(0, window.innerWidth - sprite.offsetWidth));
      vxChute *= Math.pow(0.15, dt);
      phi *= Math.pow(0.001, dt);
      rot = -phi * 180 / Math.PI;
      if (ay <= 0) atterrir(s);
    }

    // La bulle reste au-dessus de Capri tant qu'elle parle, et disparaît dès qu'elle fait autre chose
    if (bulleActive && etat !== 'parle' && etat !== 'attrapee' && etat !== 'ecrasee' && etat !== 'bug' && etat !== 'tablette') cacherBulle();
    else if (bulleActive) positionnerBulle();

    const flip = pose === MARCHE ? adir * SENS_MARCHE : (etat === 'tablette' ? flipTablette : 1);
    majTransform(flip);
    raf = requestAnimationFrame(boucle);
  }

  // Le reste de l'écran reste cliquable : seule Capri capte la souris
  document.addEventListener('dragstart', (e) => e.preventDefault()); // aucun glisser-déposer d'image
  walker.addEventListener('mouseenter', () => { survolCapri = true; majClic(); });
  walker.addEventListener('mouseleave', () => { survolCapri = false; majClic(); });

  // ===== Attraper Capri : on reste appuyé sur elle, elle s'accroche au curseur =====
  function attraperCapri() {
    if (!enAnim) return;
    session++;                        // annule ce qu'elle était en train de faire
    cancelAnimationFrame(raf);
    sprite.getAnimations().forEach((a) => a.cancel());
    walker.getAnimations().forEach((a) => a.cancel());
    sprite.style.transform = '';
    walker.style.opacity = 1;
    cacherBulle();
    ligne = null; ipcRenderer.send('ligne-finie');
    fenetre = null; fermeeEnAttente = false; lignePerdue = false;

    tenue = true;
    majClic();
    pose = 'attrapee';
    sprite.src = IMAGE_ATTRAPEE;
    sprite.style.height = HAUTEUR_ATTRAPEE * ECHELLE + 'px';
    sprite.style.width = 'auto';
    walker.style.transformOrigin = (PIVOT_X * 100) + '% ' + (PIVOT_Y * 100) + '%';

    phi = 0; omega = 0; vs = 0; vsY = 0; accX = 0; accY = 0;
    secousse = 0;
    curXAvant = curX; curYAvant = curY;
    histCorps = [];
    derniereFrame = performance.now();
    prochaineBulleAtt = derniereFrame + alea(1500, 3000);
    etat = 'attrapee';
    raf = requestAnimationFrame(boucle);
  }

  // On relâche : elle tombe en gardant la vitesse de ta souris
  function lacherCapri() {
    if (etat !== 'attrapee') return;
    tenue = false;
    survolCapri = false;
    majClic();
    cacherBulle();
    vChute = borner(vsY, -2000, 2000);
    vxChute = borner(vs, -1800, 1800);
    derniereFrame = performance.now();
    etat = 'chute';
  }

  // Appui court sur Capri : retour à la fenêtre d'appel (comme "Désanimer").
  // Appui long, ou souris qui bouge : on l'attrape.
  walker.addEventListener('pointerdown', (e) => {
    if (e.button !== 0 || !enAnim || tenue) return;
    if (etat === 'puce' || etat === 'reboot' || etat === 'bug' || etat === 'tablette') return; // Capri est absente, en réinitialisation ou en plein bug
    e.preventDefault(); // empêche le navigateur de "saisir" l'image (glisser-déposer natif)
    walker.setPointerCapture(e.pointerId);
    curX = e.clientX; curY = e.clientY;
    const x0 = e.clientX, y0 = e.clientY;
    let attrapee = false;
    const attraper = () => { if (!attrapee) { attrapee = true; attraperCapri(); } };

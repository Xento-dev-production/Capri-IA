    const pas = Math.min(8, Math.floor(d / FRAG_ESPACE));     // si la souris va vite, on comble le trou
    for (let i = 1; i <= pas; i++) {
      const t = i / pas;
      const x = dernierFragX + (puceX - dernierFragX) * t;
      const y = dernierFragY + (puceY - dernierFragY) * t;
      const n = FRAG_MIN + Math.floor(Math.random() * (FRAG_MAX - FRAG_MIN + 1));
      for (let k = 0; k < n; k++) fragmentPuce(x + alea(-20, 20), y + alea(-16, 16));
    }
    dernierFragX = puceX; dernierFragY = puceY;

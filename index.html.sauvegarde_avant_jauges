    d.innerHTML = '<div class="rt-l"><span></span><em>EN ATTENTE</em><b>0%</b></div><div class="jb"><div class="jf"></div></div>';
    d.querySelector('span').textContent = nom;
    rootListe.appendChild(d);
    return { f: d.querySelector('.jf'), v: d.querySelector('b'), e: d.querySelector('em') };
  });
  function majRoot(p) {
    lignesRoot.forEach((l, i) => {
      const [, debut, k] = TACHES_ROOT[i];
      let v = (p - debut) / (100 - debut) * 100 * k + (p > debut ? (Math.random() - 0.5) * 3 : 0);
      v = p >= 100 ? 100 : Math.max(0, Math.min(99, v));
      l.f.style.width = v.toFixed(0) + '%';
      l.v.textContent = v.toFixed(0) + '%';
      l.e.textContent = v <= 0 ? 'EN ATTENTE' : (v >= 100 ? 'TERMINÉ' : 'EN COURS');
      l.e.className = v >= 100 ? 'fin' : (v > 0 ? 'cours' : '');

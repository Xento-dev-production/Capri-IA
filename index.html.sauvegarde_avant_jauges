<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  :root { --vert: #00ffa3; --rouge: #ff2e63; --cadre: #ff4d5a; --cyan: #27e6ff; }

  /* Permet d'animer la rotation propre de chaque fragment */
  @property --spin {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  body { user-select: none; }
  #msg { user-select: text; }
  html, body {
    margin: 0; background: transparent; overflow: hidden;
    font-family: Consolas, "Courier New", monospace; color: #e8fff6;
  }

  /* L'orbe : plat, 2D, plus lent */
  #orb {
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; height: 100vh; cursor: pointer;
  }
  /* Zone de l'orbe : boule centrale + fragments qui tournent */
  .ball-zone { position: relative; width: 170px; height: 170px; }

  .core {
    position: absolute; left: 50%; top: 50%;
    width: 22px; height: 22px; margin: -11px 0 0 -11px;
    border-radius: 50%; background: var(--vert);
    box-shadow: 0 0 12px var(--vert);
    animation: pulse 3.4s ease-in-out infinite;
  }
  @keyframes pulse { 0%, 100% { transform: scale(0.8); } 50% { transform: scale(1.2); } }

  /* Les fragments tournent autour du centre */
  .orbit {
    position: absolute; inset: 0;
    filter: drop-shadow(0 0 3px rgba(0, 255, 163, 0.7));
    animation: spin 9s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Chaque fragment tourne aussi sur lui-même */
  .frag {
    position: absolute; left: 50%; top: 50%;
    width: var(--w); height: var(--h);
    margin: calc(var(--h) / -2) 0 0 calc(var(--w) / -2);
    background: var(--col);
    transform: rotate(var(--a)) translateY(calc(var(--r) * -1)) rotate(calc(var(--t) + var(--spin)));
    animation: tourne 3s linear infinite;
  }
  @keyframes tourne { to { --spin: 360deg; } }
  /* Un fragment sur deux tourne dans l'autre sens et à une autre vitesse */
  .frag:nth-child(even) { animation-duration: 4.5s; animation-direction: reverse; }
  .frag:nth-child(3n) { animation-duration: 2.2s; }

  /* Trois formes d'éclats, façon verre brisé */
  .s1 { clip-path: polygon(0 0, 100% 20%, 60% 100%); }
  .s2 { clip-path: polygon(20% 0, 100% 0, 80% 100%, 0 70%); }
  .s3 { clip-path: polygon(0 40%, 70% 0, 100% 60%, 30% 100%); }

  /* Cadre rouge aux coins coupés autour de CALLING */
  .callframe {
    --c: 10px; margin-top: 10px;
    background: var(--cadre); padding: 2px;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--c)),
      calc(100% - var(--c)) 100%, 0 100%);
    animation: alerte 1.6s steps(2, start) infinite;
  }
  @keyframes alerte { 50% { background: var(--rouge); } }
  .calling {
    display: flex; align-items: center; gap: 8px;
    padding: 6px 16px 6px 10px; background: #000;
    font-size: 13px; letter-spacing: 3px; color: var(--vert);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px),
      calc(100% - 8px) 100%, 0 100%);
  }
  .calling::before {
    content: ""; width: 7px; height: 7px; background: var(--rouge);
  }

  /* Trois points qui apparaissent puis disparaissent */
  .d { opacity: 0; animation: dot 1.8s infinite; }
  .d2 { animation-delay: 0.3s; }
  .d3 { animation-delay: 0.6s; }
  @keyframes dot {
    0%, 15% { opacity: 0; }
    30%, 75% { opacity: 1; }
    90%, 100% { opacity: 0; }
  }

  /* La fenêtre d'appel */
  #call {
    display: none; flex-direction: column; box-sizing: border-box;
    margin: 12px; height: calc(100vh - 24px); padding: 10px;
    background: rgba(5, 5, 8, 0.92); border: 2px solid var(--vert);
    border-radius: 14px; box-shadow: 0 0 10px var(--vert);
  }

  /* Les deux cadres façon Cyberpunk */
  #frames { display: flex; gap: 10px; align-items: flex-end; flex-shrink: 0; }
  .bloc { transition: opacity 0.25s; }
  .bloc.inactif { opacity: 0.4; }
  #capriBox { flex: 1; min-width: 0; }
  #moiBox { width: 86px; flex-shrink: 0; }

  .conn { font-size: 9px; color: var(--cadre); letter-spacing: 1px; margin-bottom: 2px; }
  .nom {
    display: flex; align-items: center; gap: 6px; margin-bottom: 4px;
    font-family: Bahnschrift, "Segoe UI", Arial, sans-serif;
    font-size: 20px; font-weight: bold; letter-spacing: 2px;
    color: var(--cyan); text-shadow: 0 0 6px rgba(39, 230, 255, 0.5);
  }
  #moiBox .nom { font-size: 16px; }

  /* Le cadre : contour rouge aux coins coupés */
  .frame {
    --c: 14px;
    background: var(--cadre); padding: 2px; box-sizing: border-box;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--c)),
      calc(100% - var(--c)) 100%, calc(var(--c) - 2px) 100%, 0 calc(100% - 6px));
  }
  .frame-in {
    --d: calc(var(--c) - 2px);
    position: relative; overflow: hidden; height: 100%; background-color: #000;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--d)),
      calc(100% - var(--d)) 100%, calc(var(--d) - 2px) 100%, 0 calc(100% - 5px));
  }
  .capriframe { height: 180px; }
  .moiframe { --c: 9px; height: 86px; }

  /* Petits points rouges dans le fond du cadre */
  .dots {
    position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(rgba(255, 77, 90, 0.55) 1px, transparent 1.6px);
    background-size: 18px 18px;
  }
  .moi-in { display: flex; align-items: center; justify-content: center; }

  /* L'image avec grésillements (--img change à chaque réponse) */
  #portrait {
    --img: url(capri.jpg);
    animation: flick 6s steps(1) infinite;
  }
  #portrait .layer {
    position: absolute; inset: 0;
    background-image: var(--img); background-size: cover; background-position: center;
  }
  #portrait .g1, #portrait .g2 { background-blend-mode: multiply; clip-path: inset(0 0 100% 0); }
  #portrait .g1 { background-color: #00ffa3; animation: glitchA 3.4s steps(1) infinite; }
  #portrait .g2 { background-color: #ff2e63; animation: glitchB 4.3s steps(1) infinite; }
  #portrait .scan {
    position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(0,0,0,0.28) 0 1px, transparent 1px 3px);
  }
  @keyframes glitchA {
    0%, 100% { clip-path: inset(0 0 100% 0); }
    10% { clip-path: inset(20% 0 65% 0); transform: translateX(-9px); }
    12% { clip-path: inset(55% 0 30% 0); transform: translateX(11px); }
    14% { clip-path: inset(0 0 100% 0); }
    50% { clip-path: inset(70% 0 12% 0); transform: translateX(8px); }
    52% { clip-path: inset(5% 0 85% 0); transform: translateX(-11px); }
    54% { clip-path: inset(0 0 100% 0); }
    80% { clip-path: inset(40% 0 45% 0); transform: translateX(-7px); }
    82% { clip-path: inset(0 0 100% 0); }
  }
  @keyframes glitchB {
    0%, 100% { clip-path: inset(0 0 100% 0); }
    22% { clip-path: inset(35% 0 52% 0); transform: translateX(10px); }
    24% { clip-path: inset(80% 0 5% 0); transform: translateX(-9px); }
    26% { clip-path: inset(0 0 100% 0); }
    63% { clip-path: inset(12% 0 75% 0); transform: translateX(-12px); }
    65% { clip-path: inset(60% 0 25% 0); transform: translateX(9px); }
    67% { clip-path: inset(0 0 100% 0); }
    90% { clip-path: inset(25% 0 60% 0); transform: translateX(7px); }
    92% { clip-path: inset(0 0 100% 0); }
  }
  @keyframes flick {
    0%, 100% { filter: none; }
    41% { filter: brightness(1.7) contrast(1.4); }
    42% { filter: none; }
    77% { filter: brightness(0.6) hue-rotate(40deg); }
    78% { filter: brightness(1.5); }
    79% { filter: none; }
  }

  /* Discussion */
  #chat {
    flex: 1; overflow-y: auto; margin-top: 12px; min-height: 0;
    display: flex; flex-direction: column; gap: 8px;
  }
  /* Barre de défilement du chat */
  #chat::-webkit-scrollbar {
    width: 8px;
  }
  #chat::-webkit-scrollbar-track {
    background: #000;
    border-left: 1px solid var(--cadre);
  }
  #chat::-webkit-scrollbar-thumb {
    background: var(--vert);
    box-shadow: 0 0 6px var(--vert);
  }
  #chat::-webkit-scrollbar-thumb:hover {
    background: var(--rouge);
    box-shadow: 0 0 6px var(--rouge);
  }
  /* Enlève les flèches haut et bas */
  #chat::-webkit-scrollbar-button {
    display: none;
  }
  .row { display: flex; gap: 8px; align-items: flex-start; }
  .row.moi { flex-direction: row-reverse; }
  .tag {
    flex-shrink: 0; padding: 3px 7px; font-size: 11px;
    font-weight: bold; letter-spacing: 2px; border: 1px solid;
  }
  .capri .tag { color: var(--cyan); border-color: var(--cyan); }
  .moi .tag { color: var(--cadre); border-color: var(--cadre); }
  .txt { font-size: 13px; line-height: 1.4; }
  .moi .txt { text-align: right; }

  #inputrow { display: flex; gap: 6px; margin-top: 8px; }
  #msg {
    flex: 1; background: #000; color: #e8fff6; border: 1px solid var(--cadre);
    padding: 7px; font-family: inherit; font-size: 13px; outline: none;
  }
  #send {
    background: transparent; color: var(--cadre); border: 1px solid var(--cadre);
    padding: 0 12px; cursor: pointer; font-family: inherit;
  }
  #hangup {
    margin-top: 8px; background: transparent; color: var(--vert);
    border: 1px solid var(--vert); padding: 6px; cursor: pointer;
    font-family: inherit; letter-spacing: 2px;
  }

  /* Menu clic droit cyberpunk */
  #menu {
    display: none; position: fixed; z-index: 200; --c: 10px;
    background: var(--vert); padding: 2px;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--c)),
      calc(100% - var(--c)) 100%, 0 100%);
  }
  #menu .in {
    background: #000; min-width: 160px; padding: 4px 0;
    border-left: 3px solid var(--rouge); border-right: 3px solid var(--rouge);
    box-shadow: inset 10px 0 12px -8px var(--rouge), inset -10px 0 12px -8px var(--rouge);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--c) + 2px),
      calc(100% - var(--c) + 2px) 100%, 0 100%);
  }
  #menu button {
    display: block; width: 100%; text-align: left; background: transparent; border: 0;
    color: var(--vert); font-family: inherit; font-size: 13px; letter-spacing: 3px;
    padding: 8px 16px; cursor: pointer; text-shadow: 0 0 6px rgba(0, 255, 163, 0.6);
  }
  #menu button::before { content: "▸ "; color: var(--rouge); opacity: 0; }
  #menu button:hover { background: rgba(255, 46, 99, 0.18); color: var(--cyan); }
  #menu button:hover::before { opacity: 1; }

  /* Bulle de dialogue de Capri (style cyberpunk, comme le CALLING) */
  #bulle {
    display: none; position: absolute; left: 0; top: 0; z-index: 50;
    pointer-events: none; will-change: transform;
  }
  .bulle-cadre {
    --c: 12px; background: var(--cadre); padding: 2px;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--c)),
      calc(100% - var(--c)) 100%, 0 100%);
    animation: alerte 1.6s steps(2, start) infinite;
  }
  .bulle-in {
    display: flex; gap: 8px; align-items: flex-start;
    background: #000; padding: 7px 16px 7px 10px; max-width: 210px;
    font-size: 13px; line-height: 1.35; letter-spacing: 1px; color: var(--vert);
    text-shadow: 0 0 6px rgba(0, 255, 163, 0.5);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px),
      calc(100% - 10px) 100%, 0 100%);
  }
  .bulle-in::before {
    content: ""; flex-shrink: 0; width: 7px; height: 7px; margin-top: 5px;
    background: var(--rouge);
  }
  /* La petite pointe qui montre Capri */
  .queue {
    position: absolute; left: 18px; bottom: -9px; width: 14px; height: 11px;
    background: var(--cadre); clip-path: polygon(0 0, 100% 0, 0 100%);
    animation: alerte 1.6s steps(2, start) infinite;
  }

  /* Mode balade */
  #anim { display: none; position: fixed; inset: 0; overflow: hidden; }
  #walker { position: absolute; bottom: 0; left: 0; cursor: pointer; will-change: transform; }
  #walker img { display: block; filter: drop-shadow(0 0 6px rgba(0, 255, 163, 0.5));
    -webkit-user-drag: none; user-select: none; }
  /* L'écrasement part du bas du sprite */
  #sprite { transform-origin: 50% 100%; }

  /* ===== La puce (référence à Cyberpunk) ===== */
  #puce {
    display: none; position: absolute; left: 0; top: 0; z-index: 60;
    cursor: grab; will-change: transform; touch-action: none;
    filter: drop-shadow(0 0 4px rgba(39, 230, 255, 0.95)) drop-shadow(0 0 14px rgba(39, 230, 255, 0.35));
    -webkit-user-drag: none; user-select: none;
  }
  #puce.tenue { cursor: grabbing; }

  /* Les deux ports USB, en haut à droite de l'écran */
  /* Hors balade, les ports sont dans une petite fenêtre à part (voir main.js). Pendant la balade, ce sont ceux-ci. */
  /* NOUVEAU : pendant la balade, les ports sont rentrés au-dessus de l'écran. Ils glissent à leur place
     quand on ouvre le dock (poignée en haut au milieu) ou quand la puce doit être branchée. */
  #usb { display: none; position: fixed; top: 0; right: 0; z-index: 50; pointer-events: none;
    transform: scale(1.25); transform-origin: top right;
    translate: 0 -260%; transition: translate 0.6s cubic-bezier(0.2, 0.9, 0.25, 1.08); }
  body.enAnim #usb { display: block; }
  body.dockOuvert #usb { translate: 0 0; }
  .ports { display: flex; gap: 14px; justify-content: flex-end; }
  .port {
    --c: 8px; position: relative; width: 66px; height: 24px;
    background: var(--cadre); padding: 2px; box-sizing: border-box;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--c)),
      calc(100% - var(--c)) 100%, 0 100%);
    animation: alerte 1.6s steps(2, start) infinite;
  }
  .port-in { position: relative; height: 100%; background: #000; }
  /* La languette métallique au fond du port */
  .port-in::after {
    content: ""; position: absolute; left: 8px; right: 8px; top: 50%;
    height: 4px; margin-top: -2px; background: #3a4558;
  }
  .port.survol { background: var(--vert); animation: none; }
  .port.survol .port-in::after { background: var(--vert); box-shadow: 0 0 8px var(--vert); }
  #usbHint {
    display: none; margin-top: 6px; text-align: right; font-size: 10px;
    letter-spacing: 3px; color: var(--cadre); text-shadow: 0 0 6px rgba(255, 77, 90, 0.6);
    animation: dot 1.8s infinite;
  }

  /* ===== NOUVEAU : le dock (poignée en haut de l'écran) ===== */
  #dockHandle {
    display: none; position: fixed; top: 0; left: 50%; width: 132px; height: 16px; margin-left: -66px;
    z-index: 64; cursor: pointer; transition: height 0.18s;
  }
  body.enAnim #dockHandle { display: block; }
  #dockHandle:hover { height: 24px; }
  #dockHandle .dh-c {
    height: 100%; background: var(--cadre); padding: 0 2px 2px; box-sizing: border-box;
    clip-path: polygon(0 0, 100% 0, 90% 100%, 10% 100%);
    animation: alerte 1.6s steps(2, start) infinite;
  }
  #dockHandle .dh-in {
    height: 100%; background: #000; display: flex; align-items: center; justify-content: center; gap: 8px;
    clip-path: polygon(0 0, 100% 0, 89% 100%, 11% 100%);
    font-size: 8px; letter-spacing: 3px; color: var(--cyan); text-shadow: 0 0 6px rgba(39, 230, 255, 0.6);
  }
  #dockHandle svg { transition: transform 0.45s; flex-shrink: 0; }
  #dockHandle:hover .dh-c { background: var(--vert); animation: none; }
  body.dockOuvert #dockHandle .dh-c { background: var(--vert); animation: none; }
  body.dockOuvert #dockHandle svg { transform: rotate(180deg); }

  /* La puce : une petite carte à contacts dorés, façon "shard" de Cyberpunk */
  .puce-corps {
    --c: 12px; width: 100%; height: 100%; box-sizing: border-box; padding: 2px; background: var(--cyan);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--c)),
      calc(100% - var(--c)) 100%, 0 100%);
  }
  .puce-in {
    position: relative; width: 100%; height: 100%; overflow: hidden;
    background: radial-gradient(ellipse at 30% 30%, rgba(255, 46, 99, 0.3), transparent 62%),
                linear-gradient(145deg, #0a1822 0%, #12060d 100%);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--c) + 2px),
      calc(100% - var(--c) + 2px) 100%, 0 100%);
  }
  .puce-pins {
    position: absolute; left: 9px; right: 9px; top: 0; height: 6px;
    background: repeating-linear-gradient(90deg, #e0b84e 0 5px, transparent 5px 8px);
    box-shadow: 0 1px 4px rgba(224, 184, 78, 0.6);
  }
  #puceImg {
    position: absolute; left: 5px; top: 9px; width: calc(100% - 10px); height: calc(100% - 14px);
    object-fit: contain; -webkit-user-drag: none;
  }
  .puce-led {
    position: absolute; right: 7px; bottom: 6px; width: 5px; height: 5px; background: var(--vert);
    box-shadow: 0 0 6px var(--vert); animation: tagpulse 1s ease-in-out infinite;
  }

  /* Le viseur autour de la puce : quatre coins qui pulsent (vert quand un port est détecté) */
  #puceCible {
    display: none; position: absolute; left: 0; top: 0; z-index: 58; pointer-events: none;
    --k: var(--cyan);
    background:
      linear-gradient(var(--k), var(--k)) 0 0 / 14px 2px no-repeat,
      linear-gradient(var(--k), var(--k)) 0 0 / 2px 14px no-repeat,
      linear-gradient(var(--k), var(--k)) 100% 0 / 14px 2px no-repeat,
      linear-gradient(var(--k), var(--k)) 100% 0 / 2px 14px no-repeat,
      linear-gradient(var(--k), var(--k)) 0 100% / 14px 2px no-repeat,
      linear-gradient(var(--k), var(--k)) 0 100% / 2px 14px no-repeat,
      linear-gradient(var(--k), var(--k)) 100% 100% / 14px 2px no-repeat,
      linear-gradient(var(--k), var(--k)) 100% 100% / 2px 14px no-repeat;
    filter: drop-shadow(0 0 4px var(--k));
    animation: cible 1s ease-in-out infinite;
  }
  #puceCible.vert { --k: var(--vert); }
  @keyframes cible { 50% { scale: 1.09; } }

  /* L'étiquette "PUCE" qui flotte au-dessus, reliée au viseur par un petit trait */
  #puceTag { display: none; position: absolute; left: 0; top: 0; z-index: 61; pointer-events: none; white-space: nowrap; }
  .tag-cadre {
    --c: 10px; background: var(--cadre); padding: 2px;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--c)),
      calc(100% - var(--c)) 100%, 0 100%);
    animation: alerte 1.6s steps(2, start) infinite;
  }
  .tag-in {
    background: #000; padding: 5px 16px 6px 10px; animation: tagglitch 3.2s steps(1) infinite;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px),
      calc(100% - 8px) 100%, 0 100%);
  }
  .tag-t {
    display: flex; align-items: center; gap: 8px; font-size: 15px; letter-spacing: 6px;
    color: var(--vert); text-shadow: 0 0 7px rgba(0, 255, 163, 0.6);
  }
  .tag-t::before { content: ""; width: 6px; height: 6px; background: var(--rouge); }
  .tag-s { margin-top: 2px; font-size: 9px; letter-spacing: 2px; color: var(--cyan); }
  .tag-ligne {
    position: relative; width: 1px; height: 14px; margin: 0 auto;
    background: var(--cyan); box-shadow: 0 0 5px var(--cyan);
  }
  .tag-ligne::after {
    content: ""; position: absolute; left: -3px; bottom: -3px; width: 7px; height: 7px;
    background: var(--cyan); transform: rotate(45deg);
  }
  @keyframes tagglitch {
    0%, 100% { transform: none; filter: none; }
    40% { transform: translateX(-2px); }
    41% { transform: translateX(3px); filter: hue-rotate(60deg); }
    42% { transform: none; filter: none; }
    80% { transform: translateX(2px); }
    81% { transform: none; }
  }
  /* La lueur de la puce posée au sol */
  #puceAura {
    display: none; position: absolute; left: 0; top: 0; z-index: 59; width: 110px; height: 14px;
    border-radius: 50%; pointer-events: none; animation: tagpulse 1.2s ease-in-out infinite;
    background: radial-gradient(ellipse, rgba(39, 230, 255, 0.75) 0, rgba(39, 230, 255, 0.25) 45%, transparent 72%);
  }
  @keyframes tagpulse { 50% { opacity: 0.45; } }

  /* Un port où la puce est branchée */
  .port.connecte { background: var(--vert); animation: none; }
  .port.connecte .port-in { box-shadow: inset 0 0 10px var(--vert); }
  .port.connecte .port-in::after { background: var(--vert); box-shadow: 0 0 8px var(--vert); }
  .port.flash { background: #fff; }
  #flashUsb {
    position: absolute; inset: 0; z-index: 96; pointer-events: none; opacity: 0;
    background: radial-gradient(circle at 95% 0%, rgba(39, 230, 255, 0.6), rgba(39, 230, 255, 0.15) 40%, transparent 70%);
  }

  /* ===== Les trois fenêtres de "hacking" ===== */
  #reboot { display: none; position: absolute; inset: 0; z-index: 70; pointer-events: none; }
  .rb-scene {
    position: absolute; left: 50%; top: 0; width: 1400px; height: 900px; margin-left: -700px;
    transform-origin: top center;
  }
  .rb-fenetre { display: none; position: absolute; }
  .rb-cadre {
    --c: 16px; background: var(--cadre); padding: 2px;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--c)),
      calc(100% - var(--c)) 100%, 0 100%);
    animation: alerte 1.6s steps(2, start) infinite;
  }
  .rb-cadre.cy { background: var(--cyan); animation: none; }
  .rb-cadre.ro { background: var(--rouge); animation: none; }
  .rb-in {
    position: relative; box-sizing: border-box; padding: 18px 24px 18px 20px; background: #000;

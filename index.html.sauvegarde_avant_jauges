  const hex = (n) => { let s = ''; for (let i = 0; i < n; i++) s += Math.floor(Math.random() * 16).toString(16).toUpperCase(); return s; };

  // Fenêtre RÉINITIALISATION : une ligne de plus dans le terminal
  function ajouterLog() {
    let txt, tag = 'OK', cls = 'ok';

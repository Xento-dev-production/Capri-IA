  // Les 4 jauges de la fenêtre RÉINITIALISATION : [vitesse, retard] par rapport à la progression
  const COEFS_JAUGES = [[1, 0], [1.15, 0], [0.85, 0], [1.25, -25]];
  function majJauges(p) {
    jauges.forEach((j, i) => {
      const [k, d] = COEFS_JAUGES[i];
      let v = (p + d) * k + (Math.random() - 0.5) * 4;
      v = p >= 100 ? 100 : Math.max(0, Math.min(99, v));
      j.f.style.width = v.toFixed(0) + '%';

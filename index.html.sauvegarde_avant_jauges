      'clip-path:' + FRAG_FORMES[Math.floor(Math.random() * FRAG_FORMES.length)] + ';' +
      'filter:drop-shadow(0 0 3px ' + c + ');';
    anim.appendChild(el);
    const rot = alea(0, 360).toFixed(0);
    el.animate([
      { opacity: 0, transform: 'rotate(' + rot + 'deg) scale(0.2)' },
      { opacity: 1, transform: 'rotate(' + rot + 'deg) scale(1.3)', offset: 0.06 },
      { opacity: 1, transform: 'rotate(' + rot + 'deg) scale(1)', offset: 0.12 },
      { opacity: 0.85, transform: 'rotate(' + rot + 'deg) scale(1)', offset: 0.6 },
      { opacity: 0, transform: 'rotate(' + rot + 'deg) scale(0.8)' }
    ], { duration: FRAG_DUREE * alea(0.8, 1.3), easing: 'linear' }).onfinish = () => el.remove();
  }

  // Appelée à chaque image tant qu'on tient la puce : sème des fragments le long du chemin

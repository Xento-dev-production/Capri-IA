<script>
  const { ipcRenderer } = require('electron');
  const orb = document.getElementById('orb');
  const call = document.getElementById('call');
  const chat = document.getElementById('chat');
  const input = document.getElementById('msg');
  const portrait = document.getElementById('portrait');
  const capriBox = document.getElementById('capriBox');
  const moiBox = document.getElementById('moiBox');
  let greeted = false;
  let busy = false;
  let aDeplace = false;  // vrai si on vient de déplacer une fenêtre à la souris (ce n'est pas un clic)
  const history = [];

  // Les images de Capri : pour en ajouter, ajoute simplement son nom dans la liste
  const IMAGES = ['capri.jpg', 'capri2.jpg', 'capri3.jpg', 'capri4.jpg', 'capri5.jpg'];
  let imageActuelle = 0;
  IMAGES.forEach((nom) => { new Image().src = nom; }); // pré-chargement

  // Change d'image au hasard, jamais deux fois la même d'affilée
  function changerImage() {
    let n;
    do {
      n = Math.floor(Math.random() * IMAGES.length);
    } while (n === imageActuelle && IMAGES.length > 1);
    imageActuelle = n;
    portrait.style.setProperty('--img', "url('" + IMAGES[n] + "')");
  }

  // Allume le cadre de celui qui parle ('capri', 'moi', ou null pour les deux)
  function parle(qui) {
    capriBox.classList.toggle('inactif', qui === 'moi');
    moiBox.classList.toggle('inactif', qui === 'capri');
  }

  // Numéro de connexion différent à chaque appel
  function chiffres(n) {
    let s = '';
    for (let i = 0; i < n; i++) s += Math.floor(Math.random() * 10);
    return s;
  }

  const wait = (ms) => new Promise((r) => setTimeout(r, ms));
  const borner = (v, min, max) => Math.min(Math.max(v, min), max);

  function addRow(who) {
    const row = document.createElement('div');
    row.className = 'row ' + who;
    row.innerHTML = '<div class="tag">' + (who === 'capri' ? 'CAPRI' : 'MOI') +
                    '</div><div class="txt"></div>';
    chat.appendChild(row);
    chat.scrollTop = chat.scrollHeight;
    return row.querySelector('.txt');
  }

  async function typeInto(el, text, speed) {
    for (const c of text) {
      el.textContent += c;
      chat.scrollTop = chat.scrollHeight;
      await wait(speed);
    }
  }

  async function send() {
    const text = input.value.trim();
    if (!text || busy) return;
    busy = true;
    input.value = '';

    parle('moi');
    await typeInto(addRow('moi'), text, 12);
    history.push({ role: 'user', content: text });

    parle('capri');
    const capriTxt = addRow('capri');
    capriTxt.textContent = '···';
    const reply = await ipcRenderer.invoke('ask', history);
    capriTxt.textContent = '';

    if (reply.startsWith('[Erreur')) {
      history.pop();
    } else {
      history.push({ role: 'assistant', content: reply });
      while (history.length > 20) history.splice(0, 2);
      changerImage(); // nouvelle image à chaque réponse
    }
    await typeInto(capriTxt, reply, 28);
    parle(null);
    busy = false;
    input.focus();
  }

  orb.addEventListener('click', async () => {
    if (aDeplace) { aDeplace = false; return; } // on vient de la déplacer : ce n'est pas un clic
    ipcRenderer.send('mode', 'call');
    orb.style.display = 'none';
    call.style.display = 'flex';
    document.getElementById('conn').textContent =
      'CONNECTION ' + chiffres(3) + '.' + chiffres(2) + '.' + chiffres(2);
    if (!greeted) {
      greeted = true;
      parle('capri');
      await typeInto(addRow('capri'), 'Salut, choom. Ça faisait un moment.', 28);
      await wait(600);
      await typeInto(addRow('capri'), "Je suis là. Qu'est-ce qu'on fait aujourd'hui ?", 28);
      parle(null);
    }
    input.focus();
  });

  document.getElementById('send').addEventListener('click', send);
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') send(); });

  // ===== État de la balade =====
  const anim = document.getElementById('anim');
  const walker = document.getElementById('walker');
  const sprite = document.getElementById('sprite');
  const NS = 'http://www.w3.org/2000/svg';

  let ax = 0, adir = 1, etat = 'cache', finEtat = 0, raf = null;
  let ay = 0;                // hauteur de Capri au-dessus du bas de l'écran (0 = au sol)
  let cibleAx = 0, cibleAy = 0; // où elle doit se trouver quand elle est assise (suit la fenêtre)
  let decalageX = 0;         // sa place sur la fenêtre (distance depuis le bord gauche)
  let fenetre = null;        // la fenêtre sur laquelle elle est assise
  let fermeeEnAttente = false;
  let enAnim = false;        // vrai quand Capri se balade
  let session = 0;           // change à chaque début/fin de balade (annule les anciennes animations)
  let survolCapri = false;   // la souris est sur Capri
  let menuOuvert = false;

  // Capri attrapée par la souris
  let tenue = false;         // vrai tant qu'on reste appuyé sur Capri
  let phi = 0, omega = 0;    // inclinaison de Capri (radians) et sa vitesse de balancement
  let rot = 0;               // la même inclinaison, en degrés, pour l'affichage
  let vs = 0;                // vitesse (lissée) de la souris vers la droite ou la gauche
  let curX = 0, curY = 0;    // position de la souris
  let curXAvant = 0;
  let derniereFrame = 0;
  let vChute = 0;            // vitesse de chute quand on la lâche
  let prochaineBulleAtt = 0; // prochaine phrase pendant qu'on la tient
  let vxChute = 0;           // vitesse vers la droite ou la gauche gardée quand on la lâche
  let vsY = 0, accX = 0, accY = 0, curYAvant = 0;  // vitesse et accélération de la souris
  let histCorps = [];        // positions récentes de son corps (pour la traînée d'éclairs)
  let prochaineTrainee = 0;
  // 'puce' = elle a disparu, on attend qu'on glisse la puce dans un port USB ; 'reboot' = réinitialisation
  const occupee = () => etat === 'attrapee' || etat === 'chute' || etat === 'ecrasee' ||
                        etat === 'puce' || etat === 'reboot' || etat === 'bug' || etat === 'tablette';

  // ===== Déplacer la fenêtre en restant appuyé (orbe et fenêtre d'appel) =====
  // Pendant la balade, ça ne fait rien (à améliorer plus tard).
  function activerDeplacement(zone, interdit) {
    zone.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || enAnim) return;
      if (interdit && interdit(e)) return;
      aDeplace = false;
      const x0 = e.screenX, y0 = e.screenY;
      zone.setPointerCapture(e.pointerId);
      ipcRenderer.send('drag-start');
      const bouge = (m) => {
        if (Math.hypot(m.screenX - x0, m.screenY - y0) > 5) aDeplace = true;
      };
      const fin = () => {
        zone.removeEventListener('pointermove', bouge);
        zone.removeEventListener('pointerup', fin);
        zone.removeEventListener('pointercancel', fin);
        ipcRenderer.send('drag-stop');
      };
      zone.addEventListener('pointermove', bouge);
      zone.addEventListener('pointerup', fin);
      zone.addEventListener('pointercancel', fin);
    });
  }
  activerDeplacement(orb);
  // Dans la fenêtre d'appel : on peut la saisir partout, sauf sur la case d'écriture,
  // les boutons et la barre de défilement du chat
  activerDeplacement(call, (e) => e.target.closest('input, button') ||
    (e.target === chat && e.clientX > chat.getBoundingClientRect().left + chat.clientWidth));

  // Le clic passe à travers l'écran, sauf sur Capri, sur la puce, ou quand le menu est ouvert
  function majClic() {
    if (enAnim) ipcRenderer.send('clickthrough', !(survolCapri || menuOuvert || tenue || survolPuce || puceTenue || uiCapte()));
  }

  // Place Capri à l'écran (position horizontale, hauteur et sens)
  function majTransform(flip) {
    walker.style.transform = 'translate(' + ax + 'px,' + (-ay) + 'px) rotate(' + rot + 'deg) scaleX(' + flip + ')';
  }

  // ===== Bulle de dialogue =====
  const bulle = document.getElementById('bulle');
  const bulleTxt = document.getElementById('bulleTxt');
  const queue = document.getElementById('queue');

  // Place la bulle au-dessus de la tête de Capri
  function positionnerBulle() {
    const bw = bulle.offsetWidth, bh = bulle.offsetHeight;
    const w = sprite.offsetWidth, h = sprite.offsetHeight * (etat === 'ecrasee' ? 0.35 : 1);
    const centre = ax + w / 2;
    const x = borner(centre - 24, 6, Math.max(6, window.innerWidth - bw - 6));
    const y = Math.max(4, window.innerHeight - ay - h - bh - 14);
    bulle.style.transform = 'translate(' + x + 'px,' + y + 'px)';
    queue.style.left = borner(centre - x - 7, 8, Math.max(8, bw - 30)) + 'px';
  }

  function cacherBulle() {
    bulleId++;
    bulleActive = false;
    bulle.getAnimations().forEach((a) => a.cancel()); // enlève l'ancienne transparence
    bulle.style.display = 'none'; bulleTxt.classList.remove('longue');
  }

  // Elle dit une phrase : la bulle apparaît, le texte s'écrit, reste un moment,
  // puis s'efface lentement. Renvoie true si tout s'est bien passé.
  // (liste : les phrases possibles, duree : temps affiché, fondu : temps de disparition)
  async function direPhrase(liste = PHRASES, duree = BULLE_DUREE, fondu = BULLE_FONDU) {
    const id = ++bulleId;
    if (liste !== derniereListe) { dernierePhrase = -1; derniereListe = liste; }
    let n;
    do { n = Math.floor(Math.random() * liste.length); } while (n === dernierePhrase && liste.length > 1);
    dernierePhrase = n;
    const phrase = liste[n];

    bulle.getAnimations().forEach((a) => a.cancel());
    bulleActive = true;
    bulleTxt.textContent = '';
    bulle.style.display = 'block';
    positionnerBulle();
    bulle.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 120 });

    for (const c of phrase) {
      if (id !== bulleId) return false;
      bulleTxt.textContent += c;
      await wait(38);
    }
    await wait(duree);
    if (id !== bulleId) return false;

    await bulle.animate([{ opacity: 1 }, { opacity: 0 }], { duration: fondu, fill: 'forwards' }).finished;
    if (id !== bulleId) return false;
    cacherBulle();
    return true;
  }

  // ===== Raccrocher / désanimer =====
  // Arrête la balade et renvoie la position de Capri (pour placer la fenêtre)
  function arreterBalade() {
    session++;
    cancelAnimationFrame(raf);
    etat = 'cache';
    const centre = ax + sprite.offsetWidth / 2;
    enAnim = false;
    survolCapri = false;
    menuOuvert = false;
    tenue = false; rot = 0; phi = 0; omega = 0;
    walker.style.transformOrigin = '';
    walker.style.pointerEvents = '';
    ay = 0; cibleAy = 0;
    fenetre = null;
    ligne = null;
    cacherBulle();
    document.body.classList.remove('enAnim');
    nettoyerPuce(); nettoyerDiscussion(); // retire la puce, le message USB et l'interface de réinitialisation
    dockOuvert = false; dockForce = false; survolDock = false;  // le dock se range
    document.body.classList.remove('dockOuvert');
    ipcRenderer.send('ligne-finie');
    fermeeEnAttente = false;
    anim.style.display = 'none';
    return centre;
  }

  function raccrocher() {
    if (enAnim) {
      const centre = arreterBalade();
      ipcRenderer.send('mode', 'orb', centre);
    } else {
      ipcRenderer.send('mode', 'orb');
    }
    call.style.display = 'none';
    orb.style.display = 'flex';
  }

  function desanimer() {
    const centre = arreterBalade();
    ipcRenderer.send('mode', 'call', centre);
    call.style.display = 'flex';
    input.focus();
  }

  document.getElementById('hangup').addEventListener('click', raccrocher);

  // ===== Menu cyberpunk (clic droit) =====
  const menu = document.getElementById('menu');
  const mAnim = document.getElementById('mAnim');
  const mDesanim = document.getElementById('mDesanim');

  function ouvrirMenu(x, y) {
    // Pendant la balade : RACCROCHER + DÉSANIMER. Sinon : RACCROCHER + ANIMER.
    mAnim.style.display = enAnim ? 'none' : 'block';
    mDesanim.style.display = enAnim ? 'block' : 'none';
    menu.style.display = 'block';
    x = Math.min(x, window.innerWidth - menu.offsetWidth - 4);
    y = Math.min(y, window.innerHeight - menu.offsetHeight - 4);
    menu.style.left = Math.max(4, x) + 'px';
    menu.style.top = Math.max(4, y) + 'px';
    menuOuvert = true;
    majClic();
  }
  function fermerMenu() {
    if (menu.style.display !== 'block') return;
    menu.style.display = 'none';
    menuOuvert = false;
    majClic();
  }

  call.addEventListener('contextmenu', (e) => { e.preventDefault(); ouvrirMenu(e.clientX, e.clientY); });
  walker.addEventListener('contextmenu', (e) => { e.preventDefault(); ouvrirMenu(e.clientX, e.clientY); });
  ipcRenderer.on('menu-at', (e, x, y) => ouvrirMenu(x, y));
  document.addEventListener('mousedown', (e) => { if (!menu.contains(e.target)) fermerMenu(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fermerMenu(); });
  window.addEventListener('blur', fermerMenu);
  document.getElementById('mHang').addEventListener('click', () => { fermerMenu(); raccrocher(); });
  mAnim.addEventListener('click', () => { fermerMenu(); animer(); });
  mDesanim.addEventListener('click', () => { fermerMenu(); desanimer(); });

  // ===== Réglages de la balade =====
  const ECHELLE = 0.30;            // taille de Capri (plus petit = plus petite)
  const VITESSE = 0.8;              // pixels par image
  const SENS_MARCHE = 1;           // mets -1 si elle marche en arrière
  const MARCHE = 7;                // la marche (animée avec les images capri7_1.png, capri7_2.png...)
  const POSES = [6, 8, 9, 10, 11]; // les images d'arrêt
  const HAUTEURS = { 6: 582, 7: 577, 8: 484, 9: 565, 10: 571, 11: 557 };

  // ----- Capri assise sur une fenêtre -----
  // L'image de Capri assise sur les fenêtres (ici capri8.png).
  // Sa taille est calculée toute seule à partir de l'image (avec ECHELLE).
  const IMAGE_ASSISE = 'capri8.png';
  // De temps en temps, elle disparaît et réapparaît ailleurs sur la fenêtre (en ms, min et max)
  const SAUT_MIN = 8000;
  const SAUT_MAX = 20000;
  let prochainSaut = 0;

  // ----- Capri attrapée par la souris (quand on reste appuyé sur elle) -----
  const IMAGE_ATTRAPEE = 'capri_attrape.png'; // mains jointes, accrochées au curseur
  const HAUTEUR_ATTRAPEE = 600;   // sa taille quand on la tient (même échelle que HAUTEURS)
  const RATIO_ATTRAPEE = 0.455;   // largeur / hauteur de l'image
  const PIVOT_X = 0.41;           // où sont ses mains dans l'image (de 0 à 1) : c'est là que le curseur l'accroche
  const PIVOT_Y = 0.04;
  const DELAI_ATTRAPE = 220;      // temps d'appui avant de l'attraper (ms)
  const GRAVITE = 1800;           // plus grand = elle revient plus vite à la verticale
  const TRAINEE = 1.15;           // plus grand = elle se penche plus quand tu bouges vite
  const AMORTI = 1.7;             // plus petit = elle se balance plus longtemps
  const ANGLE_MAX = 1.5;          // inclinaison maximale (radians, environ 86 degrés)

  // Gerbe à l'impact (quand elle touche le sol)
  const NB_ECLAIRS_IMPACT = 12;   // éclairs qui partent dans tous les sens
  const NB_FICHIERS = 22;         // fichiers qui giclent partout
  const COULEURS_FICHIERS = ['#00ffa3', '#ff2e63', '#27e6ff', '#e8fff6', '#ffe600'];
  const GRAVITE_CHUTE = 2600;     // vitesse de sa chute quand tu la lâches

  // Écrasement au sol
  const CREPE = 'scale(1.3, 0.35)';  // sa forme de crêpe (le 2e chiffre = l'épaisseur)
  const DUREE_CREPE = 1800;       // temps où la phrase reste affichée une fois écrite (ms) : écrasée en tout environ 3,5 s
  const PHRASES_AIE = [
    "Ouais, tu m'as fait mal, choom !",
    "Aïe ! Ça fait mal, choom !",
    "Ouille... mes implants !",
    "Tchoum... c'est pas nova, ça.",
    "J'ai failli flatline, gonk !",
    "Mes chromes ont pris cher...",
    "Aïe, ça pique, choom !",
    "Même un solo aurait eu mal !",
    "Mon cyberware est en vrac..."
  ];

  // Traînée pluie de code (couleurs de Capri) : des caractères de code qui s'échappent de Capri et retombent en s'effaçant
  const TRAINEE_PAUSE = 30;       // temps entre deux apparitions (ms) : plus petit = plus de caractères
  const TRAINEE_NOMBRE_MIN = 4;   // nombre minimal de caractères à chaque apparition
  const TRAINEE_NOMBRE_MAX = 6;   // nombre maximal de caractères à chaque apparition
  const TRAINEE_VITESSE = 300;    // vitesse minimale (pixels par seconde) pour laisser une traînée
  const TRAINEE_DUREE = 750;      // temps que met un caractère pour disparaître (ms)
  const TRAINEE_CARACTERES = '01010101ABCDEF<>/#$%';  // les caractères possibles : ajoute-en si tu veux
  const TRAINEE_PALETTE = [['#fb116e', '#fb116e'], ['#fb116e', '#fb116e'], ['#fb116e', '#fb116e'], ['#01ec54', '#01ec54'], ['#01ec54', '#01ec54'], ['#01ec54', '#01ec54'], ['#ffffff', '#fb116e'], ['#ffffff', '#01ec54']];  // rose, vert, et blanc avec une lueur rose ou verte
  const BULLE_ATT_MIN = 5000;     // temps entre deux phrases pendant qu'on la tient (ms)
  const BULLE_ATT_MAX = 9000;
  const PHRASES_ATTRAPEE = [
    "Arrête ça, choom !",
    "Lâche-moi, gonk !",
    "Hé, je suis pas un cyberdeck !",
    "Doucement, choom !",
    "C'est incroyable, Nova !",
    "Preem ! Encore !",
    "Plus fort, choom !",
    "Ça, c'est nova !"
  ];

  // ----- Bulles de dialogue (elle s'assoit au sol pour les dire) -----
  const BULLE_MIN = 15000;   // temps entre deux phrases (ms, min et max) : plus grand = plus rare
  const BULLE_MAX = 35000;
  const BULLE_DUREE = 6500;  // temps pendant lequel la phrase reste affichée une fois écrite (ms)
  const BULLE_FONDU = 2500;  // temps que met la phrase pour disparaître en transparence (ms)
  // Pour ajouter une phrase, ajoute simplement une ligne dans la liste
  const PHRASES = [
    "Eh oh, t'es là, choom ?",
    "Choom, on me parle ?",
    "Réveille-toi, samouraï.",
    "Night City ne dort jamais.",
    "Un petit run ce soir, choom ?",
    "Ne fais pas le gonk, choom.",
    "Preem, ce bureau.",
    "Tu rêves ou tu bosses ?",
    "Je m'ennuie, choom...",
    "Plus d'eddies, moins de bugs."
  ];
  let prochaineBulle = 0;
  let bulleActive = false;   // vrai quand la bulle est affichée
  let bulleId = 0;           // change à chaque bulle (annule les anciennes)
  let dernierePhrase = -1;
  let derniereListe = null;

  // ----- Escapades sur les lignes d'une grande fenêtre -----
  const ESCAPADE_MIN = 6000;  // temps passé au sol entre deux escapades (ms, min et max)
